
<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerLevel'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.level' value='{{system.power.level}}' data-dtype='Number' />
  </div>
</div>
<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerRange'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.range' value='{{system.power.range}}' />
  </div>
</div>
<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerTarget'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.target' value='{{system.power.target}}' />
  </div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.ItemFeature.area'}}</label>
  <div class='resource-content'>
    <select name='system.power.area'>{{selectOptions @root.powerAreaValues localize=true selected=system.power.area blank=''}}</select>
    {{#if system.power.area}}
    <select name='system.power.area_shape'>{{selectOptions @root.areaShapes localize=true selected=system.power.area_shape}}</select>
    <select name='system.power.area_affects'>{{selectOptions @root.areaAffects localize=true selected=system.power.area_affects}}</select>
    <select name='system.power.area_resolve'>{{selectOptions @root.areaResolve localize=true selected=system.power.area_resolve}}</select>
    {{#if (eq system.power.area_resolve 'save')}}
    <select name='system.power.area_save_ability'>{{selectOptions @root.areaSaveAbilities localize=true selected=system.power.area_save_ability}}</select>
    <select name='system.power.area_save_difficulty'>{{selectOptions @root.areaSaveDifficulties localize=true selected=system.power.area_save_difficulty}}</select>
    {{#if (eq system.power.area_save_difficulty 'target')}}<input type='number' name='system.power.area_save_target' value='{{system.power.area_save_target}}' min='1' step='1' data-dtype='Number' />{{/if}}
    <select name='system.power.area_save_pass'>{{selectOptions @root.areaSavePass localize=true selected=system.power.area_save_pass}}</select>
    {{/if}}
    <label data-tooltip="{{localize 'SDM.AreaLingerHint'}}"><input type='checkbox' name='system.power.area_linger' {{checked system.power.area_linger}} /> {{localize 'SDM.AreaLinger'}}</label>
    {{#if system.power.area_linger}}<input type='number' name='system.power.area_rounds' value='{{system.power.area_rounds}}' min='0' step='1' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaRoundsHint'}}" />
    <label data-tooltip="{{localize 'SDM.AreaFollowsHint'}}"><input type='checkbox' name='system.power.area_follows' {{checked system.power.area_follows}} /> {{localize 'SDM.AreaFollows'}}</label>
    <select name='system.power.area_round_damage' data-tooltip="{{localize 'SDM.AreaRoundDamageHint'}}">{{selectOptions @root.areaRoundDamage localize=true selected=system.power.area_round_damage}}</select>{{#if (eq system.power.area_round_damage 'formula')}}<input type='text' name='system.power.area_round_formula' value='{{system.power.area_round_formula}}' data-tooltip="{{localize 'SDM.AreaRoundFormula'}}" />{{/if}}
            <label data-tooltip="{{localize 'SDM.AreaRoundEnterHint'}}"><input type='checkbox' name='system.power.area_round_enter' {{checked system.power.area_round_enter}} /> {{localize 'SDM.AreaRoundEnter'}}</label>
            <select name='system.power.area_round_condition' data-tooltip="{{localize 'SDM.AreaRoundConditionHint'}}">{{selectOptions @root.triggerStatuses selected=system.power.area_round_condition}}</select>{{#if system.power.area_round_condition}}<input type='number' name='system.power.area_round_condition_rounds' value='{{system.power.area_round_condition_rounds}}' min='0' step='1' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaRoundConditionRounds'}}: {{localize 'SDM.AreaRoundConditionRoundsHint'}}" />{{/if}}<select name='system.power.area_light' data-tooltip="{{localize 'SDM.AreaLight'}}: {{localize 'SDM.AreaLightHint'}}">{{selectOptions @root.areaLights localize=true selected=system.power.area_light}}</select>{{/if}}
    <input type='number' name='system.power.area_across' value='{{system.power.area_across}}' min='0' step='any' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaAcrossHint'}}" />
    {{/if}}
  </div>
</div>
<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerDuration'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.duration' value='{{system.power.duration}}' />
  </div>
</div>

<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerRollFormula'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.roll_formula' value='{{system.power.roll_formula}}' />
  </div>
</div>

<div class='resource'>
  {{#if (ne item.parent.type 'npc')}}
    <label class='resource-label'>
      {{localize 'SDM.AbilityModifier'}}
    </label>
    <div class='resource-content'>
      <select name='system.power.default_ability' id='system.power.default_ability'>
        <option value=''></option>
        {{selectOptions abilities localize=true selected=system.power.default_ability}}
      </select>
    </div>
  {{/if}}
</div>

<div class="resource align-center">
  <label class='resource-label'>{{localize 'SDM.PowerIsDangerous'}}</label>
  <div class='resource-content align-center'>
    <input type='checkbox' name='system.power.is_dangerous' {{checked system.power.is_dangerous}} />
  </div>
</div>

<div class="resource align-center" data-tooltip="{{localize 'SDM.SingleUse.Hint'}}">
  <label class='resource-label'><i class="fa-solid fa-triangle-exclamation"></i> {{localize 'SDM.SingleUse.Label'}}</label>
  <div class='resource-content align-center'>
    <input type='checkbox' name='system.power.single_use' {{checked system.power.single_use}} />
  </div>
</div>

{{#if (sdmFeature 'lights')}}
<div class='resource' data-tooltip="{{localize 'SDM.Light.PowerHint'}}">
  <label class='resource-label'><i class="fa-solid fa-fire-flame-curved"></i> {{localize 'SDM.Light.Label'}}</label>
  <div class='resource-content'>
    <select name="system.power.light.preset">
      {{selectOptions @root.powerLightPresets selected=system.power.light.preset localize=true}}
    </select>
  </div>
</div>
{{#if (eq system.power.light.preset 'custom')}}
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Bright'}}</label>
  <div class='resource-content'><input type='number' name="system.power.light.bright" value="{{system.power.light.bright}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}"/></div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Dim'}}</label>
  <div class='resource-content'><input type='number' name="system.power.light.dim" value="{{system.power.light.dim}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}"/></div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Color'}}</label>
  <div class='resource-content'><color-picker name="system.power.light.color" value="{{system.power.light.color}}"></color-picker></div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Animation'}}</label>
  <div class='resource-content'><select name="system.power.light.animation">{{selectOptions @root.lightAnimations selected=system.power.light.animation localize=true}}</select></div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Speed'}}</label>
  <div class='resource-content'><input type="number" name="system.power.light.speed" value="{{system.power.light.speed}}" min="0" max="10" step="1" /></div>
</div>
<div class='resource'>
  <label class='resource-label'>{{localize 'SDM.Light.Intensity'}}</label>
  <div class='resource-content'><input type="number" name="system.power.light.intensity" value="{{system.power.light.intensity}}" min="0" max="10" step="1" /></div>
</div>
{{/if}}
{{/if}}

<div class='resource'>
  <label class='resource-label'>
    {{localize 'SDM.PowerOverchargeRollFormula'}}
  </label>
  <div class='resource-content'>
    <input type='text' name='system.power.overcharge_roll_formula' value='{{system.power.overcharge_roll_formula}}' />
  </div>
</div>

<div class='resource grid-span-2'>
  <label class='resource-label'>
    {{localize 'SDM.PowerOvercharge'}}
  </label>
  <div class='resource-content grid-span-1 flexcol'>
    <textarea class='flexcol' name='system.power.overcharge' rows='2'>{{{system.power.overcharge}}}</textarea>
  </div>
</div>

