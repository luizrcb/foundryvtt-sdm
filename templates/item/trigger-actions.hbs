{{! A trigger's actions (or a consumable's Use actions). Params: trigger, index, prefix ("system.triggers.N." / "system.use.actions.") }}
<details class="sdm-trigger-actions" data-index="{{index}}" {{#if (or trigger.cost_resource trigger.table trigger.effect trigger.wear trigger.counter_scope trigger.counter trigger.cast trigger.use trigger.light trigger.charges_mode trigger.status trigger.life_mode trigger.ability_damage trigger.purge trigger.roll_formula trigger.hero_dice trigger.animate)}}open{{/if}}>
  <summary>{{localize 'SDM.Trigger.Actions'}}</summary>
  <div class="sdm-counter-row">
    <label class="{{#if trigger.cost_resource}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.CostHint'}}">{{localize 'SDM.Trigger.Cost'}}
      <select name="{{prefix}}cost_resource">{{selectOptions @root.triggerCostResources selected=trigger.cost_resource localize=true}}</select>
      {{#if trigger.cost_resource}}
      <input class="sdm-trigger-cost" type="text" name="{{prefix}}cost" value="{{trigger.cost}}" data-tooltip="{{localize 'SDM.Trigger.CostFormulaHint'}}" />
      <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.CostAskHint'}}"><input type="checkbox" name="{{prefix}}cost_ask" {{checked trigger.cost_ask}} /> {{localize 'SDM.Trigger.CostAsk'}}</span>
      {{else}}
      <input type="hidden" name="{{prefix}}cost" value="{{trigger.cost}}" />
      <input type="hidden" name="{{prefix}}cost_ask" value="{{trigger.cost_ask}}" data-dtype="Boolean" />
      {{/if}}</label>
    <label class="{{#if trigger.table}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.TableHint'}}">{{localize 'SDM.Trigger.Table'}}
      <input class="sdm-trigger-table" type="text" name="{{prefix}}table" value="{{trigger.table}}" placeholder="{{localize 'SDM.Trigger.TablePlaceholder'}}" /></label>
    <label class="{{#if trigger.effect}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.EffectHint'}}">{{localize 'SDM.Trigger.Effect'}}
      <select name="{{prefix}}effect">{{selectOptions @root.triggerEffects selected=trigger.effect}}</select>
      {{!-- Details of an action only show once the action is picked --}}
      {{#if trigger.effect}}
      <select name="{{prefix}}effect_target">{{selectOptions @root.triggerEffectTargets selected=trigger.effect_target localize=true}}</select>
      <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.EffectSaveHint'}}"><input type="checkbox" name="{{prefix}}effect_save" {{checked trigger.effect_save}} /> {{localize 'SDM.Trigger.StatusSave'}}</span>
      {{#if trigger.effect_save}}
      <select name="{{prefix}}effect_save_ability" data-tooltip="{{localize 'SDM.Trigger.StatusSaveAbilityHint'}}">{{selectOptions @root.triggerSaveAbilities selected=trigger.effect_save_ability localize=true}}</select>
      <select name="{{prefix}}effect_save_difficulty" data-tooltip="{{localize 'SDM.SaveDifficulty.Hint'}}">{{selectOptions @root.triggerSaveDifficulties selected=trigger.effect_save_difficulty localize=true}}</select>
      {{#if (eq trigger.effect_save_difficulty 'target')}}
      <input class="sdm-trigger-amount" type="number" min="1" step="1" name="{{prefix}}effect_save_target" value="{{trigger.effect_save_target}}" data-tooltip="{{localize 'SDM.SaveDifficulty.TargetHint'}}" />
      {{else}}
      <input type="hidden" name="{{prefix}}effect_save_target" value="{{trigger.effect_save_target}}" />
      {{/if}}
      {{else}}
      <input type="hidden" name="{{prefix}}effect_save_difficulty" value="{{trigger.effect_save_difficulty}}" /><input type="hidden" name="{{prefix}}effect_save_target" value="{{trigger.effect_save_target}}" />
      <input type="hidden" name="{{prefix}}effect_save_ability" value="{{trigger.effect_save_ability}}" />
      {{/if}}
      {{else}}
      <input type="hidden" name="{{prefix}}effect_target" value="{{trigger.effect_target}}" />
      <input type="hidden" name="{{prefix}}effect_save" value="{{trigger.effect_save}}" data-dtype="Boolean" />
      <input type="hidden" name="{{prefix}}effect_save_ability" value="{{trigger.effect_save_ability}}" />
      <input type="hidden" name="{{prefix}}effect_save_difficulty" value="{{trigger.effect_save_difficulty}}" /><input type="hidden" name="{{prefix}}effect_save_target" value="{{trigger.effect_save_target}}" />
      {{/if}}</label>
    <label class="{{#if trigger.status}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.StatusHint'}}">{{localize 'SDM.Trigger.Status'}}
      <select name="{{prefix}}status">{{selectOptions @root.triggerStatuses selected=trigger.status}}</select>
      {{#if trigger.status}}
      <select name="{{prefix}}status_mode">{{selectOptions @root.triggerStatusModes selected=trigger.status_mode localize=true}}</select>
      <select name="{{prefix}}status_target">{{selectOptions @root.triggerEffectTargets selected=trigger.status_target localize=true}}</select>
      {{#if (ne trigger.status_mode 'remove')}}
      <input class="sdm-trigger-amount" type="number" min="0" step="1" name="{{prefix}}status_duration" value="{{trigger.status_duration}}" data-tooltip="{{localize 'SDM.Trigger.StatusDurationHint'}}" />
      <select name="{{prefix}}status_duration_units" data-tooltip="{{localize 'SDM.Trigger.StatusDurationHint'}}">{{selectOptions @root.useDurationUnits selected=trigger.status_duration_units localize=true}}</select>
      <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.StatusSaveHint'}}"><input type="checkbox" name="{{prefix}}status_save" {{checked trigger.status_save}} /> {{localize 'SDM.Trigger.StatusSave'}}</span>
      {{#if trigger.status_save}}
      <select name="{{prefix}}status_save_ability" data-tooltip="{{localize 'SDM.Trigger.StatusSaveAbilityHint'}}">{{selectOptions @root.triggerSaveAbilities selected=trigger.status_save_ability localize=true}}</select>
      <select name="{{prefix}}status_save_difficulty" data-tooltip="{{localize 'SDM.SaveDifficulty.Hint'}}">{{selectOptions @root.triggerSaveDifficulties selected=trigger.status_save_difficulty localize=true}}</select>
      {{#if (eq trigger.status_save_difficulty 'target')}}
      <input class="sdm-trigger-amount" type="number" min="1" step="1" name="{{prefix}}status_save_target" value="{{trigger.status_save_target}}" data-tooltip="{{localize 'SDM.SaveDifficulty.TargetHint'}}" />
      {{else}}
      <input type="hidden" name="{{prefix}}status_save_target" value="{{trigger.status_save_target}}" />
      {{/if}}
      {{else}}
      <input type="hidden" name="{{prefix}}status_save_difficulty" value="{{trigger.status_save_difficulty}}" /><input type="hidden" name="{{prefix}}status_save_target" value="{{trigger.status_save_target}}" />
      <input type="hidden" name="{{prefix}}status_save_ability" value="{{trigger.status_save_ability}}" />
      {{/if}}
      {{else}}
      <input type="hidden" name="{{prefix}}status_duration" value="{{trigger.status_duration}}" />
      <input type="hidden" name="{{prefix}}status_duration_units" value="{{trigger.status_duration_units}}" />
      <input type="hidden" name="{{prefix}}status_save" value="{{trigger.status_save}}" data-dtype="Boolean" />
      <input type="hidden" name="{{prefix}}status_save_ability" value="{{trigger.status_save_ability}}" />
      <input type="hidden" name="{{prefix}}status_save_difficulty" value="{{trigger.status_save_difficulty}}" /><input type="hidden" name="{{prefix}}status_save_target" value="{{trigger.status_save_target}}" />
      {{/if}}
      {{else}}
      <input type="hidden" name="{{prefix}}status_mode" value="{{trigger.status_mode}}" />
      <input type="hidden" name="{{prefix}}status_target" value="{{trigger.status_target}}" />
      <input type="hidden" name="{{prefix}}status_duration" value="{{trigger.status_duration}}" />
      <input type="hidden" name="{{prefix}}status_duration_units" value="{{trigger.status_duration_units}}" />
      <input type="hidden" name="{{prefix}}status_save" value="{{trigger.status_save}}" data-dtype="Boolean" />
      <input type="hidden" name="{{prefix}}status_save_ability" value="{{trigger.status_save_ability}}" />
      <input type="hidden" name="{{prefix}}status_save_difficulty" value="{{trigger.status_save_difficulty}}" /><input type="hidden" name="{{prefix}}status_save_target" value="{{trigger.status_save_target}}" />
      {{/if}}</label>
    <label class="{{#if trigger.wear}}filled{{/if}}">{{localize 'SDM.Trigger.WearLabel'}}
      <select name="{{prefix}}wear">{{selectOptions @root.triggerWear selected=trigger.wear localize=true}}</select></label>
    <label class="{{#if trigger.counter}}filled{{/if}}">{{localize 'SDM.Trigger.Counter'}}
      <select name="{{prefix}}counter_scope" data-tooltip="{{localize 'SDM.Trigger.ScopeHint'}}">{{selectOptions @root.triggerScopes selected=trigger.counter_scope localize=true}}</select>
      <select name="{{prefix}}counter">{{#if (eq trigger.counter_scope 'actor')}}{{selectOptions @root.triggerActorCounters selected=trigger.counter}}{{else}}{{selectOptions @root.triggerCounters selected=trigger.counter}}{{/if}}</select>
      {{#if trigger.counter}}
      <select name="{{prefix}}counter_mode">{{selectOptions @root.triggerCounterModes selected=trigger.counter_mode localize=true}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}counter_mode" value="{{trigger.counter_mode}}" />
      {{/if}}
      {{#if (or (not trigger.counter) (eq trigger.counter_mode 'reset'))}}
      <input type="hidden" name="{{prefix}}counter_step" value="{{trigger.counter_step}}" />
      {{else}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}counter_step" value="{{trigger.counter_step}}" data-tooltip="{{localize 'SDM.Trigger.CounterStepHint'}}" />
      {{/if}}</label>
    <label class="{{#if trigger.cast}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.CastHint'}}">{{localize 'SDM.Trigger.Cast'}}
      <select name="{{prefix}}cast">{{selectOptions @root.triggerCastItems selected=trigger.cast}}</select>
      {{#if trigger.cast}}
      <input type="text" name="{{prefix}}cast_power" value="{{trigger.cast_power}}" placeholder="{{localize 'SDM.Trigger.CastPowerPlaceholder'}}" data-tooltip="{{localize 'SDM.Trigger.CastPowerHint'}}" />
      <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.CastFreeHint'}}"><input type="checkbox" name="{{prefix}}cast_free" {{checked trigger.cast_free}} /> {{localize 'SDM.Trigger.CastFree'}}</span>
      {{else}}
      <input type="hidden" name="{{prefix}}cast_power" value="{{trigger.cast_power}}" />
      <input type="hidden" name="{{prefix}}cast_free" value="{{trigger.cast_free}}" data-dtype="Boolean" />
      {{/if}}</label>
    <label class="{{#if trigger.charges_mode}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.ChargesHint'}}">{{localize 'SDM.Trigger.Charges'}}
      <select name="{{prefix}}charges_mode">{{selectOptions @root.triggerChargeModes selected=trigger.charges_mode localize=true}}</select>
      {{#if trigger.charges_mode}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}charges_amount" value="{{trigger.charges_amount}}" data-tooltip="{{localize 'SDM.Trigger.AmountHint'}}" />
      <select name="{{prefix}}charges_item">{{selectOptions @root.triggerChargeItems selected=trigger.charges_item}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}charges_amount" value="{{trigger.charges_amount}}" />
      <input type="hidden" name="{{prefix}}charges_item" value="{{trigger.charges_item}}" />
      {{/if}}</label>
    <label class="{{#if trigger.use}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.UseHint'}}">{{localize 'SDM.Trigger.Use'}}
      <select name="{{prefix}}use">{{selectOptions @root.triggerUseItems selected=trigger.use}}</select></label>
    {{#if (sdmFeature 'lights')}}
    <label class="{{#if trigger.light}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.LightHint'}}">{{localize 'SDM.Trigger.Light'}}
      <select name="{{prefix}}light">{{selectOptions @root.triggerLightModes selected=trigger.light localize=true}}</select>
      {{#if trigger.light}}
      <select name="{{prefix}}light_item">{{selectOptions @root.triggerLightItems selected=trigger.light_item}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}light_item" value="{{trigger.light_item}}" />
      {{/if}}
      {{#if (eq trigger.light 'flare')}}
      <input class="sdm-trigger-amount" type="number" min="0" step="1" name="{{prefix}}light_duration" value="{{trigger.light_duration}}" data-tooltip="{{localize 'SDM.Trigger.FlareHint'}}" />
      <select name="{{prefix}}light_duration_units">{{selectOptions @root.useDurationUnits selected=trigger.light_duration_units localize=true}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}light_duration" value="{{trigger.light_duration}}" />
      <input type="hidden" name="{{prefix}}light_duration_units" value="{{trigger.light_duration_units}}" />
      {{/if}}</label>
    {{else}}
    <input type="hidden" name="{{prefix}}light" value="{{trigger.light}}" />
    <input type="hidden" name="{{prefix}}light_item" value="{{trigger.light_item}}" />
    <input type="hidden" name="{{prefix}}light_duration" value="{{trigger.light_duration}}" />
    <input type="hidden" name="{{prefix}}light_duration_units" value="{{trigger.light_duration_units}}" />
    {{/if}}
    <label class="{{#if trigger.life_mode}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.LifeHint'}}">{{localize 'SDM.Trigger.Life'}}
      <select name="{{prefix}}life_mode">{{selectOptions @root.triggerLifeModes selected=trigger.life_mode localize=true}}</select>
      {{#if trigger.life_mode}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}life_amount" value="{{trigger.life_amount}}" placeholder="1d6" data-tooltip="{{localize 'SDM.Trigger.AmountHint'}}" />
      <select name="{{prefix}}life_target">{{selectOptions @root.triggerEffectTargets selected=trigger.life_target localize=true}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}life_amount" value="{{trigger.life_amount}}" />
      <input type="hidden" name="{{prefix}}life_target" value="{{trigger.life_target}}" />
      {{/if}}</label>
<label class="{{#if trigger.ability_damage}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.AbilityDamageHint'}}">{{localize 'SDM.Trigger.AbilityDamage'}}
      <select name="{{prefix}}ability_damage">{{selectOptions @root.triggerAbilityDamage selected=trigger.ability_damage localize=true}}</select>
      {{#if trigger.ability_damage}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}ability_damage_amount" value="{{trigger.ability_damage_amount}}" placeholder="1" data-tooltip="{{localize 'SDM.Trigger.AmountHint'}}" />
      <select name="{{prefix}}ability_damage_target">{{selectOptions @root.triggerEffectTargets selected=trigger.ability_damage_target localize=true}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}ability_damage_amount" value="{{trigger.ability_damage_amount}}" />
      <input type="hidden" name="{{prefix}}ability_damage_target" value="{{trigger.ability_damage_target}}" />
      {{/if}}</label>
    <label class="{{#if trigger.purge}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.PurgeHint'}}">{{localize 'SDM.Trigger.Purge'}}
      <select name="{{prefix}}purge">{{selectOptions @root.triggerPurgeModes selected=trigger.purge localize=true}}</select></label>
    <label class="{{#if trigger.roll_formula}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.RollHint'}}">{{localize 'SDM.Trigger.RollFormula'}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}roll_formula" value="{{trigger.roll_formula}}" /></label>
    <label class="{{#if trigger.hero_dice}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.HeroDiceHint'}}">{{localize 'SDM.Trigger.HeroDice'}}
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}hero_dice" value="{{trigger.hero_dice}}" /></label>
    <label class="{{#if trigger.animate}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.AnimateHint'}}">{{localize 'SDM.Trigger.Animate'}}
      <select name="{{prefix}}animate">{{selectOptions @root.triggerAnimateModes selected=trigger.animate localize=true}}</select>
      {{#if trigger.animate}}
      <select name="{{prefix}}animate_item">{{selectOptions @root.triggerAnimateItems selected=trigger.animate_item}}</select>
      {{else}}
      <input type="hidden" name="{{prefix}}animate_item" value="{{trigger.animate_item}}" />
      {{/if}}</label>
    <label class="sdm-trigger-summon {{#if trigger.summon}}filled{{/if}}" data-tooltip="{{localize 'SDM.Trigger.SummonHint'}}">{{localize 'SDM.Trigger.Summon'}}
      <input type="hidden" name="{{prefix}}summon" value="{{trigger.summon}}" />
      {{#if trigger.summon}}
      <span class="sdm-trigger-summon-name">{{lookup @root.triggerSummonNames trigger.summon}}</span>
      <a class="sdm-trigger-summon-clear" data-tooltip="{{localize 'SDM.Trigger.SummonClear'}}"><i class="fa-solid fa-xmark" inert></i></a>
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}summon_count" value="{{trigger.summon_count}}" data-tooltip="{{localize 'SDM.Trigger.SummonCountHint'}}" />
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}summon_level" value="{{trigger.summon_level}}" data-tooltip="{{localize 'SDM.Trigger.SummonLevelHint'}}" />
      <input class="sdm-trigger-amount" type="number" min="0" step="1" name="{{prefix}}summon_rounds" value="{{trigger.summon_rounds}}" data-tooltip="{{localize 'SDM.Trigger.SummonRoundsHint'}}" />
      <input class="sdm-trigger-amount" type="text" name="{{prefix}}summon_limit" value="{{trigger.summon_limit}}" data-tooltip="{{localize 'SDM.Trigger.SummonLimitHint'}}" />
      <select name="{{prefix}}summon_place">{{selectOptions @root.triggerSummonPlaces selected=trigger.summon_place localize=true}}</select>
      <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.SummonEndsAtZeroHint'}}"><input type="checkbox" name="{{prefix}}summon_ends_at_zero" {{checked trigger.summon_ends_at_zero}} /> {{localize 'SDM.Trigger.SummonEndsAtZero'}}</span>
      {{else}}
      <span class="sdm-trigger-summon-name sdm-trigger-summon-empty">{{localize 'SDM.Trigger.SummonDrop'}}</span>
      <input type="hidden" name="{{prefix}}summon_count" value="{{trigger.summon_count}}" />
      <input type="hidden" name="{{prefix}}summon_level" value="{{trigger.summon_level}}" />
      <input type="hidden" name="{{prefix}}summon_rounds" value="{{trigger.summon_rounds}}" />
      <input type="hidden" name="{{prefix}}summon_limit" value="{{trigger.summon_limit}}" />
      <input type="hidden" name="{{prefix}}summon_place" value="{{trigger.summon_place}}" />
      <input type="hidden" name="{{prefix}}summon_ends_at_zero" value="{{trigger.summon_ends_at_zero}}" data-dtype="Boolean" />
      {{/if}}</label>
  </div>
</details>
