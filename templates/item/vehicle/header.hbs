<header class='sheet-header'>
  <img class='profile-img' src='{{item.img}}' data-edit='img' data-action='onEditImage' data-tooltip='{{item.name}}' />
  <div class='header-fields mt-10'>
    <div class='document-name'>
      <div class="flexrow flex-between">
        <input name='name' class="resource-label flexultra" type='text' value='{{item.name}}' placeholder='Name' />
      </div>
    </div>
    <div class="grid grid-3col">
      <div class='resource mr-10'>
        <label class='resource-label'>{{localize 'SDM.FieldLevel'}}</label>
        <input type='number' name='system.level' value='{{system.level}}' min='0' step='1' data-dtype='Number' />
      </div>

      <div class='resource mr-10'>
        <label class='resource-label'>{{localize 'SDM.ItemVehicleCapacity'}}</label>
        <input type='number' name='system.capacity' value='{{system.capacity}}' min='0' step='1' data-dtype='Number' />
      </div>

      <div class='resource'>
        <label class='resource-label'>{{localize 'SDM.FieldCost'}}</label>
        <input type='text' name='system.cost' value='{{system.cost}}' data-dtype='Number' />
      </div>
    </div>

    <div class="grid grid-3col mt-5">
      <div class='resource mr-10 flex-group-center'>
        <label class='resource-label' data-tooltip="{{localize 'SDM.ItemVehicleAutomaticHint'}}">{{localize 'SDM.ItemVehicleAutomatic'}} <i class='fa-solid fa-circle-question'></i></label>
        <input type='checkbox' name='system.automatic' {{checked system.automatic}} data-dtype='Boolean'
               data-tooltip="{{localize 'SDM.ItemVehicleAutomaticHint'}}" />
      </div>

      <div class='resource mr-10'>
        <label class='resource-label'>{{localize 'SDM.ItemVehicleSpeed'}}</label>
        <select name='system.speed' class="resource-content" data-dtype='Number'>
          {{selectOptions (sdmSpeedChoices system.speed) selected=system.speed}}
        </select>
      </div>

      <div class='resource'>
        <label class='resource-label' data-tooltip="SDM.FieldSupplyPerWeek">{{localize 'SDM.FieldSupply'}}</label>
        <input type='text' name='system.supply' value='{{system.supply}}' />
      </div>
    </div>
  </div>
</header>
