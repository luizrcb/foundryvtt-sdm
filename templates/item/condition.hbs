{{! Item condition controls. Hidden while the item is intact and its resources are full;
    change those from the inventory right-click menu. }}
{{#if (or system.status system.resources)}}
<div class="sdm-item-condition">
  {{#if system.status}}
  <div class="sdm-seg" role="group" aria-label="{{localize 'SDM.ItemCondition.Integrity'}}">
    <button type="button" class="sdm-seg-btn" data-action="setItemStatus" data-value="">
      <i class="fa-regular fa-circle-check"></i><span>{{localize 'SDM.ItemCondition.Intact'}}</span>
    </button>
    <button type="button" class="sdm-seg-btn {{#if (eq system.status 'notched')}}is-active is-warn{{/if}}" data-action="setItemStatus" data-value="notched">
      <i class="fa fa-hammer"></i><span>{{localize 'SDM.ItemCondition.Notched'}}</span>
    </button>
    <button type="button" class="sdm-seg-btn {{#if (eq system.status 'broken')}}is-active is-danger{{/if}}" data-action="setItemStatus" data-value="broken">
      <i class="fa fa-ban"></i><span>{{localize 'SDM.ItemCondition.Broken'}}</span>
    </button>
  </div>
  {{/if}}
  {{#if system.resources}}
  <div class="sdm-seg" role="group" aria-label="{{localize 'SDM.ItemCondition.Resources'}}">
    <button type="button" class="sdm-seg-btn" data-action="setItemResources" data-value="">
      <i class="fa-solid fa-battery-full"></i><span>{{localize 'SDM.ItemCondition.Full'}}</span>
    </button>
    <button type="button" class="sdm-seg-btn {{#if (eq system.resources 'running_low')}}is-active is-warn{{/if}}" data-action="setItemResources" data-value="running_low">
      <i class="fa-solid fa-battery-quarter"></i><span>{{localize 'SDM.ItemCondition.RunningLow'}}</span>
    </button>
    <button type="button" class="sdm-seg-btn {{#if (eq system.resources 'run_out')}}is-active is-danger{{/if}}" data-action="setItemResources" data-value="run_out">
      <i class="fa-solid fa-battery-empty"></i><span>{{localize 'SDM.ItemCondition.RunOut'}}</span>
    </button>
  </div>
  {{/if}}
</div>
{{/if}}
