{{! Album tab: the selected power (the others are hidden so their fields keep their values) }}
<div class="sdm-album-detail">
  {{#if (gt powerCount 0)}}
    {{#each powers as | power |}}
    <div class="sdm-album-power" {{#if (ne @index ../currentPowerIndex)}}hidden{{/if}}>
      <header class="sdm-album-power-header">
        <img
          class="sdm-album-power-img"
          src="{{power.img}}"
          data-edit="{{concat 'system.powers.' @index '.img'}}"
          data-index="{{@index}}"
          data-action="onEditPowerImage"
          data-tooltip="{{power.name}}"
        />
        <input class="sdm-album-power-name" type="text" name="{{concat 'system.powers.' @index '.name'}}" value="{{power.name}}"
          placeholder="{{localize 'SDM.PowerName'}}" />
        <div class="sdm-album-power-level" data-tooltip="{{localize 'SDM.PowerLevel'}}">
          <span>{{localize 'SDM.FieldLevel'}}</span>
          {{#if @root.editable}}<a data-action="stepPowerLevel" data-index="{{@index}}" data-step="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
          <input type="number" min="0" step="1" name="{{concat 'system.powers.' @index '.level'}}" value="{{power.level}}" data-dtype="Number" />
          {{#if @root.editable}}<a data-action="stepPowerLevel" data-index="{{@index}}" data-step="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
        </div>
        <div class="sdm-album-power-actions">
          {{#if @root.editable}}
          <a data-action="duplicatePower" data-index="{{@index}}" data-tooltip="{{localize 'SDM.DuplicatePower'}}"><i class="fa-solid fa-clone"></i></a>
          {{/if}}
          {{#if @root.isGM}}
          <a data-action="extractPower" data-index="{{@index}}" data-tooltip="{{localize 'SDM.ExtractPowerTooltip'}}"><i class="fa-solid fa-file-import"></i></a>
          {{/if}}
          <a data-action="deletePower" data-index="{{@index}}" data-tooltip="{{localize 'SDM.DeletePower'}}"><i class="fa-solid fa-trash"></i></a>
        </div>
      </header>

      <div class="sdm-album-fields sdm-album-fields-3">
        <label><span>{{localize 'SDM.PowerRange'}}</span>
          <input type="text" name="{{concat 'system.powers.' @index '.range'}}" value="{{power.range}}" /></label>
        <label><span>{{localize 'SDM.PowerTarget'}}</span>
          <input type="text" name="{{concat 'system.powers.' @index '.target'}}" value="{{power.target}}" /></label>
        <label><span>{{localize 'SDM.PowerDuration'}}</span>
          <input type="text" name="{{concat 'system.powers.' @index '.duration'}}" value="{{power.duration}}" /></label>
      </div>

      <div class="sdm-album-fields sdm-album-fields-4">
        <label><span>{{localize 'SDM.PowerRollFormula'}}</span>
          <input type="text" name="{{concat 'system.powers.' @index '.roll_formula'}}" value="{{power.roll_formula}}" /></label>
        <label><span>{{localize 'SDM.PowerOverchargeRollFormula'}}</span>
          <input type="text" name="{{concat 'system.powers.' @index '.overcharge_roll_formula'}}" value="{{power.overcharge_roll_formula}}" /></label>
        <label><span>{{localize 'SDM.AbilityModifier'}}</span>
          <select name="{{concat 'system.powers.' @index '.default_ability'}}">
            {{selectOptions @root.config.abilities localize=true selected=power.default_ability blank=''}}
          </select></label>
        <label class="sdm-album-check"><input type="checkbox" name="{{concat 'system.powers.' @index '.is_dangerous'}}" {{checked power.is_dangerous}} />
          <span>{{localize 'SDM.PowerIsDangerous'}}</span></label>
      </div>

      {{#if (and @root.editable (not power.overcharge))}}
      <a class="sdm-album-add-overcharge" data-action="showOvercharge"><i class="fa-solid fa-plus"></i> {{localize 'SDM.PowerOvercharge'}}</a>
      {{/if}}
      <div class="sdm-album-text sdm-album-overcharge" {{#unless power.overcharge}}hidden{{/unless}}>
        <span class="sdm-album-text-label">{{localize 'SDM.PowerOvercharge'}}</span>
        {{#if @root.editable}}
        <prose-mirror name="{{concat 'system.powers.' @index '.overcharge'}}" data-document-uuid="{{@root.item.uuid}}"
          value="{{power.overcharge}}" compact toggled>
          {{{power.overcharge}}}
        </prose-mirror>
        {{else}}
        <div>{{{power.overcharge}}}</div>
        {{/if}}
      </div>

      <div class="sdm-album-text">
        <span class="sdm-album-text-label">{{localize 'SDM.PowerDescription'}}</span>
        {{#if @root.editable}}
        <prose-mirror name="{{concat 'system.powers.' @index '.description'}}" data-document-uuid="{{@root.item.uuid}}"
          value="{{power.description}}" compact toggled>
          {{{lookup @root.enrichedPowers @index}}}
        </prose-mirror>
        {{else}}
        {{{lookup @root.enrichedPowers @index}}}
        {{/if}}
      </div>
    </div>
    {{/each}}
  {{else}}
    <div class="sdm-album-empty">
      <i class="fa-solid fa-book-open"></i>
      <p>{{localize 'SDM.NoPowers'}}</p>
      <p class="hint">{{localize 'SDM.AlbumDropHint'}}</p>
    </div>
  {{/if}}
</div>
