{{! Hallmark level-up upgrades: its progress history, pending choice and what it gained (traits expand to their description) }}
{{#if system.is_hallmark}}
<div class="sdm-hallmark-upgrades">
  {{#if @root.item.isEmbedded}}
  <a class="sdm-invest-xp" data-action="showProgressLog" data-tooltip="SDM.ProgressLog.Open"><i class="fa-solid fa-clock-rotate-left"></i></a>
  {{/if}}
  {{#if (gt system.hallmark.pending_upgrades 0)}}
  <a class="sdm-pending-upgrade" {{#if @root.editable}}data-action="chooseHallmarkUpgrade"{{/if}} data-tooltip="{{localize 'SDM.Upgrade.ChooseTooltip'}}">
    <i class="fa-solid fa-angles-up"></i> {{localize 'SDM.Upgrade.ChooseCount' count=system.hallmark.pending_upgrades}}
  </a>
  {{/if}}
  {{#if @root.hallmarkUpgrades.length}}
  <ul class="sdm-upgrade-notes">
    {{#each @root.hallmarkUpgrades}}
    {{#if this.description}}
    <li class="has-description" {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>
      <details>
        <summary><i class="{{this.icon}}"></i> {{this.label}}</summary>
        <div class="sdm-upgrade-description">{{{this.description}}}</div>
      </details>
    </li>
    {{else}}
    <li {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}><i class="{{this.icon}}"></i> {{this.label}}</li>
    {{/if}}
    {{/each}}
  </ul>
  {{/if}}
</div>
{{/if}}
