<div>
  <header class='sheet-header'>
    <div class="flexcol flex-between flex-center">
      <div class="sdm-item-portrait{{#if (eq system.status 'broken')}} is-broken{{/if}}{{#if (eq system.resources 'run_out')}} is-run-out{{/if}}">
        <img class='profile-img' src='{{item.img}}' data-edit='img' data-action='onEditImage' data-tooltip='{{item.name}}' />
        {{> "systems/sdm/templates/item/condition-overlay.hbs"}}
      </div>
      {{#if (and
        (ne system.type 'corruption')
        (ne system.type 'affliction')
        (ne system.type 'pet')
        (ne system.type 'augment')
        (ne system.type 'container')
        (ne system.size.unit 'cash')
      )}}
      <div class="align-center mb-10 mr-10 rollable" {{#if system.readied}}
        data-tooltip="{{localize 'SDM.ItemReadied' }}" {{else}} data-tooltip="{{localize 'SDM.ItemNotReadied'}}" {{/if}}
        data-action="toggleReadied">
        <div class='resource-label'>
          {{#if system.readied}}
          {{localize 'SDM.ItemReadied' }}
          {{else}}
          {{localize 'SDM.ItemNotReadied'}}
          {{/if}}
        </div>
          <i class="fa-regular fa-shield {{ifThen system.readied 'readied' 'not-readied'}}"></i>
      </div>
      {{/if}}
    </div>

    <div class='header-fields mt-10'>
      <div class='document-name'>
        <div class="flexrow flex-between">
          <input name='name' class="resource-label flexultra" type='text' value='{{item.name}}' placeholder='Name' />
          {{#unless (or
            (eq system.size.unit 'cash')
            (eq system.type 'corruption')
            (eq system.type 'affliction')
            (eq system.type 'augment')
            (eq system.type 'pet')
            (eq system.type 'container')
          )}}
          <div class="flex flex-group-center flexcol rollable" data-action="toggleIsHallmark" style="cursor:pointer;">
            <label class='resource-label'>{{localize 'SDM.HallmarkItem'}}</label>
            <i class="fa-regular fa-star mt-5 {{#if item.system.is_hallmark}}hallmark{{/if}}"></i>
          </div>
           {{/unless}}
        </div>
      </div>
      {{> "systems/sdm/templates/item/condition.hbs"}}
      {{#if (eq system.type 'affliction')}}
      <div class="grid grid-2col">
        <div class='resource mr-10'>
          <label class='resource-label'>{{localize 'SDM.Burden.StepsToCure'}}
            <input type='text' name='system.cure_steps.required' value='{{system.cure_steps.required}}' data-dtype='Number' />
          </label>
        </div>

        <div class='resource flex-group-center'>
          {{#if (gt system.cure_steps.required 0)}}
          <label class='resource-label'>{{localize 'SDM.Burden.CompletedSteps'}}</label>
          <div class="resource-content sources flex-group-center mt-5">
            {{#multiboxes system.cure_steps.completed}}
              <input type="radio" id="completed-{{item.id}}-0" name="system.cure_steps.completed" value="0" checked="checked" data-dtype='Radio' style="cursor:pointer;">
              {{#times_from 1 system.cure_steps.required}}
                <input type="radio" id="completed-{{../item.id}}-{{this}}" name="system.cure_steps.completed" value="{{this}}" data-dtype='Radio' style="cursor:pointer;">
                <label class="radio-toggle" data-action="radioToggle" for="completed-{{../item.id}}-{{this}}" style="cursor:pointer;" data-tooltip="{{this}}"></label>
              {{/times_from}}
            {{/multiboxes}}
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{#if (eq system.type 'pet')}}
        <div class='grid grid-2col'>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.ItemSizeValue'}}</label>
            <input type='text' name='system.size.value' value='{{system.size.value}}' data-dtype='Number' />
          </div>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.ItemSizeUnit'}}</label>
            <select name='system.size.unit'>
              <option value=''></option>
              {{selectOptions sizeUnits localize=true selected=system.size.unit}}
            </select>
          </div>

         {{#if petActor}}
            <div class='resource' style='grid-column: 1 / -1;'>
              <label class='resource-label'>{{localize 'SDM.LinkedPet'}}</label>
              <div class='resource-content flexrow pet-link-row'>
                <i class='fa-solid fa-paw roll-icon rollable'
                  data-action='openPetActor'
                  data-tooltip='{{petActor.name}}'></i>
                <button type='button' class='pet-unlink-btn icon fa-solid fa-link-slash'
                        data-action='unlinkActor'
                        data-tooltip='{{localize "SDM.Item.UnlinkPet"}}'></button>
              </div>
            </div>
          {{else if petMissing}}
            <div class='resource' style='grid-column: 1 / -1;'>
              <label class='resource-label'>{{localize 'SDM.LinkedPet'}}</label>
              <div class='resource-content flexrow pet-link-row'>
                <em>{{localize 'SDM.Item.PetNotFound'}}</em>
                <button type='button' class='pet-unlink-btn icon fa-solid fa-link-slash'
                        data-action='unlinkActor'
                        data-tooltip='{{localize "SDM.Item.UnlinkPet"}}'></button>
              </div>
            </div>
          {{/if}}

          </div>
        {{else}}
        {{#unless (or
          (eq system.type 'corruption')
          (eq system.type 'affliction')
          (eq system.type 'augment')
        )}}
        <div class='grid grid-{{ifThen item.system.is_hallmark 3 2}}col'>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.ItemQuantity'}}
              <input type='text' name='system.quantity' value='{{system.quantity}}' data-dtype='Number'  {{#if (eq system.type 'container')}}disabled{{/if}}/>
            </label>
          </div>
          <div class='resource'>
            {{#unless (eq system.size.unit 'cash')}}
              <label class='resource-label'>{{localize 'SDM.ItemCost'}}</label>
              <input type='text' name='system.cost' value='{{system.cost}}' data-dtype='Number' />
            {{/unless}}
          </div>

          {{#if item.system.is_hallmark}}
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.FieldLevel'}}
              <input type='text' name='system.hallmark.level' value='{{system.hallmark.level}}' data-dtype='Number' disabled />
            </label>
          </div>
          {{/if}}

          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.ItemSizeValue'}}</label>
            <input type='text' name='system.size.value' value='{{system.size.value}}' data-dtype='Number' />
          </div>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.ItemSizeUnit'}}</label>
            <select name='system.size.unit'>
              <option value=''></option>
              {{selectOptions sizeUnits localize=true selected=system.size.unit}}
            </select>
          </div>

          {{#if item.system.is_hallmark}}
          <div class='resource'{{#if @root.hallmarkXpToNextLevel}} data-tooltip="{{@root.hallmarkXpToNextLevel}} {{localize 'SDM.XPToLevelUP'}}"{{/if}}>
            <label class='resource-label' for='system.hallmark.experience'>{{localize 'SDM.FieldExperience'}}</label>
            <input type='text' name='system.hallmark.experience' value='{{system.hallmark.experience}}'{{#unless @root.isGM}} disabled{{/unless}} />
            {{> "systems/sdm/templates/item/hallmark-upgrades.hbs"}}
          </div>
          {{/if}}

          {{#unless (or (eq system.size.unit 'cash') (eq system.type 'corruption') (eq system.type 'affliction') (not (has system.features 'charges')))}}
          <div class='resource'>
            <label class='resource-label' for="system.charges.max">{{localize 'SDM.ItemCharges'}}</label>
            <div class='resource-content flexrow flex-center flex-between flex-group-center'>
              <input type='text' name="system.charges.value" value="{{system.charges.value}}" data-dtype='Number' data-tooltip="{{localize 'SDM.ItemCharges'}}"/>
              <span> / </span>
              <input type='text' name="system.charges.max" value="{{system.charges.max}}" data-dtype='Number' data-tooltip="{{localize 'SDM.ItemMaxCharges'}}"/>
            </div>
          </div>
          {{/unless}}

          {{#if (has system.features 'area')}}
          <div class='resource'>
            <label class='resource-label' for="system.area.value">{{localize 'SDM.ItemFeature.area'}}</label>
            <select name='system.area.value' data-tooltip="{{localize 'SDM.ItemFeature.areaDescription'}}">
              {{selectOptions areaValues localize=true selected=system.area.value blank=''}}
            </select>
          </div>
          {{#if (and system.area.value (ne system.area.value 'single'))}}
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.AreaShape.Label'}}</label>
            <select name='system.area.shape'>{{selectOptions areaShapes localize=true selected=system.area.shape}}</select>
          </div>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.AreaAffects.Label'}}</label>
            <select name='system.area.affects'>{{selectOptions areaAffects localize=true selected=system.area.affects}}</select>
          </div>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.AreaResolve.Label'}}</label>
            <select name='system.area.resolve'>{{selectOptions @root.areaResolve localize=true selected=system.area.resolve}}</select>
            {{#if (eq system.area.resolve 'save')}}
            <select name='system.area.save_ability'>{{selectOptions @root.areaSaveAbilities localize=true selected=system.area.save_ability}}</select>
            <select name='system.area.save_difficulty'>{{selectOptions @root.areaSaveDifficulties localize=true selected=system.area.save_difficulty}}</select>
            {{#if (eq system.area.save_difficulty 'target')}}<input type='number' name='system.area.save_target' value='{{system.area.save_target}}' min='1' step='1' data-dtype='Number' />{{/if}}
            <select name='system.area.save_pass'>{{selectOptions @root.areaSavePass localize=true selected=system.area.save_pass}}</select>
            {{/if}}
          </div>
          <div class='resource' data-tooltip="{{localize 'SDM.AreaLingerHint'}}">
            <label class='resource-label'>{{localize 'SDM.AreaLinger'}}</label>
            <input type='checkbox' name='system.area.linger' {{checked system.area.linger}} />
            {{#if system.area.linger}}<input type='number' name='system.area.rounds' value='{{system.area.rounds}}' min='0' step='1' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaRoundsHint'}}" />
            <label data-tooltip="{{localize 'SDM.AreaFollowsHint'}}"><input type='checkbox' name='system.area.follows' {{checked system.area.follows}} /> {{localize 'SDM.AreaFollows'}}</label>
            <select name='system.area.round_damage' data-tooltip="{{localize 'SDM.AreaRoundDamageHint'}}">{{selectOptions @root.areaRoundDamage localize=true selected=system.area.round_damage}}</select>{{#if (eq system.area.round_damage 'formula')}}<input type='text' name='system.area.round_formula' value='{{system.area.round_formula}}' data-tooltip="{{localize 'SDM.AreaRoundFormula'}}" />{{/if}}
            <label data-tooltip="{{localize 'SDM.AreaRoundEnterHint'}}"><input type='checkbox' name='system.area.round_enter' {{checked system.area.round_enter}} /> {{localize 'SDM.AreaRoundEnter'}}</label>
            <select name='system.area.round_condition' data-tooltip="{{localize 'SDM.AreaRoundConditionHint'}}">{{selectOptions @root.triggerStatuses selected=system.area.round_condition}}</select>{{#if system.area.round_condition}}<input type='number' name='system.area.round_condition_rounds' value='{{system.area.round_condition_rounds}}' min='0' step='1' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaRoundConditionRounds'}}: {{localize 'SDM.AreaRoundConditionRoundsHint'}}" />{{/if}}{{/if}}
          </div>
          <div class='resource' data-tooltip="{{localize 'SDM.AreaAcrossHint'}}">
            <label class='resource-label'>{{localize 'SDM.AreaAcross'}}</label>
            <input type='number' name='system.area.across' value='{{system.area.across}}' min='0' step='any' data-dtype='Number' />
          </div>
          <div class='resource' data-tooltip="{{localize 'SDM.AreaVehicleHint'}}">
            <label class='resource-label'>{{localize 'SDM.AreaVehicle'}}</label>
            <input type='checkbox' name='system.area.vehicle' {{checked system.area.vehicle}} />
          </div>
          {{/if}}
          {{/if}}

          {{#if (has system.features 'range')}}
          <div class='resource'>
            <label class='resource-label' for="system.range.value">{{localize 'SDM.ItemFeature.range'}}</label>
            <select name='system.range.value' data-tooltip="{{localize 'SDM.ItemFeature.rangeDescription'}}">
              {{selectOptions rangeValues localize=true selected=system.range.value blank=''}}
            </select>
          </div>
          {{/if}}

          {{#if (or (has system.features 'entangling') (has system.features 'petrifying') (has system.features 'heat'))}}
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.SaveDifficulty.Feature'}}</label>
            <div class='resource-content'>
              <select name="system.feature_save" data-tooltip="{{localize 'SDM.SaveDifficulty.FeatureHint'}}">{{selectOptions @root.triggerSaveDifficulties selected=system.feature_save localize=true}}</select>{{#if (eq system.feature_save 'target')}}<input type="number" min="1" step="1" name="system.feature_save_target" value="{{system.feature_save_target}}" style="max-width:4em" data-tooltip="{{localize 'SDM.SaveDifficulty.TargetHint'}}" />{{/if}}
            </div>
          </div>
          {{/if}}

          {{#if (has system.features 'flare')}}
          <div class='resource'>
            <label class='resource-label' for="system.flare.value">{{localize 'SDM.ItemFeature.flare'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.flare.value" value="{{system.flare.value}}" data-dtype='Number' data-tooltip="{{localize 'SDM.ItemFeature.flareDescription'}}"/>
            </div>
          </div>
          {{/if}}

          {{#if (has system.features 'pocket')}}
          <div class='resource'>
            <label class='resource-label' for="system.pocket.value">{{localize 'SDM.ItemFeature.pocket'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.pocket.value" value="{{system.pocket.value}}" data-dtype='Number' data-tooltip="{{localize 'SDM.ItemFeature.pocketDescription'}}"/>
            </div>
          </div>
          {{/if}}

          {{#if (or (eq system.type 'weapon') (has system.features 'weapon'))}}
          <div class='resource align-center' data-tooltip="{{localize 'SDM.WorksWhenRunOutHint'}}">
            <label class='resource-label'>{{localize 'SDM.WorksWhenRunOut'}}</label>
            <div class='resource-content align-center'>
              <input type='checkbox' name="system.works_when_run_out" {{checked system.works_when_run_out}} />
            </div>
          </div>
          {{/if}}

          {{#if (has system.features 'replenish')}}
          <div class='resource'>
            <label class='resource-label' for="system.replenish.value">{{localize 'SDM.ItemFeature.replenish'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.replenish.value" value="{{system.replenish.value}}" data-dtype='Number' data-tooltip="{{localize 'SDM.ItemFeature.replenishDescription'}}"/>
            </div>
          </div>
          {{#if (or (eq system.type 'weapon') (has system.features 'weapon'))}}
          <div class='resource align-center' data-tooltip="{{localize 'SDM.Replenish.OnAttackHint'}}">
            <label class='resource-label'>{{localize 'SDM.Replenish.OnAttack'}}</label>
            <div class='resource-content align-center'>
              <input type='checkbox' name="system.replenish.on_attack" {{checked system.replenish.on_attack}} />
            </div>
          </div>
          {{/if}}
          {{/if}}

          {{#if (has system.features 'resistant')}}
          <div class='resource'>
            <label class='resource-label' for="system.replenish.value">{{localize 'SDM.ItemFeature.resistant'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.resistant.value" value="{{system.resistant.value}}" data-tooltip="{{localize 'SDM.ItemFeature.resistantDescription'}}"/>
            </div>
          </div>
          {{/if}}

          {{#if (has system.features 'consumable')}}
          <div class='resource'>
            <label class='resource-label' for="system.use.life">{{localize 'SDM.Use.Life'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.use.life" value="{{system.use.life}}" data-tooltip="{{localize 'SDM.Use.LifeHint'}}"/>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.use.ability">{{localize 'SDM.Use.Ability'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.use.ability" value="{{system.use.ability}}" data-tooltip="{{localize 'SDM.Use.AbilityHint'}}"/>
              <select name="system.use.ability_group" data-tooltip="{{localize 'SDM.Use.GroupHint'}}">{{selectOptions @root.useAbilityGroups selected=system.use.ability_group localize=true}}</select>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.use.temp_life">{{localize 'SDM.Use.TempLifeLabel'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.use.temp_life" value="{{system.use.temp_life}}" data-tooltip="{{localize 'SDM.Use.TempLifeHint'}}"/>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.use.harm">{{localize 'SDM.Use.HarmLabel'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.use.harm" value="{{system.use.harm}}" data-tooltip="{{localize 'SDM.Use.HarmHint'}}"/>
            </div>
          </div>
          <div class='resource' data-tooltip="{{localize 'SDM.Use.CuresHint'}}">
            <label class='resource-label'>{{localize 'SDM.Use.CuresLabel'}}</label>
            <div class='resource-content'>
              <multi-select name="system.use.cures">{{selectOptions @root.useCureChoices selected=system.use.cures}}</multi-select>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.use.table">{{localize 'SDM.Use.TableLabel'}}</label>
            <div class='resource-content'>
              <input class="sdm-trigger-table" type='text' name="system.use.table" value="{{system.use.table}}" placeholder="{{localize 'SDM.Trigger.TablePlaceholder'}}" data-tooltip="{{localize 'SDM.Use.TableHint'}}"/>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label'>{{localize 'SDM.Use.DurationLabel'}}</label>
            <div class='resource-content' data-tooltip="{{localize 'SDM.Use.DurationHint'}}">
              <input type='number' min="0" name="system.use.duration.value" value="{{system.use.duration.value}}" data-dtype='Number'/>
              <select name="system.use.duration.units">{{selectOptions @root.useDurationUnits selected=system.use.duration.units localize=true}}</select>
            </div>
          </div>
          {{/if}}

          {{#if (sdmIsLight item)}}
          <div class='resource'>
            <label class='resource-label' for="system.light.preset">{{localize 'SDM.Light.Label'}}</label>
            <div class='resource-content'>
              <select name="system.light.preset" data-tooltip="{{localize 'SDM.Light.PresetHint'}}">
                {{selectOptions @root.lightPresets selected=system.light.preset localize=true}}
              </select>
            </div>
          </div>
          {{#if (eq system.light.preset 'custom')}}
          <div class='resource'>
            <label class='resource-label' for="system.light.bright">{{localize 'SDM.Light.Bright'}}</label>
            <div class='resource-content'>
              <input type='number' name="system.light.bright" value="{{system.light.bright}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}"/>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.light.dim">{{localize 'SDM.Light.Dim'}}</label>
            <div class='resource-content'>
              <input type='number' name="system.light.dim" value="{{system.light.dim}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}"/>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.light.color">{{localize 'SDM.Light.Color'}}</label>
            <div class='resource-content'>
              <color-picker name="system.light.color" value="{{system.light.color}}"></color-picker>
            </div>
          </div>
          <div class='resource'>
            <label class='resource-label' for="system.light.animation">{{localize 'SDM.Light.Animation'}}</label>
            <div class='resource-content'>
              <select name="system.light.animation">
                {{selectOptions @root.lightAnimations selected=system.light.animation localize=true}}
              </select>
            </div>
          </div>
          {{/if}}
          {{/if}}

          {{#if (eq system.type 'container')}}
          <div class='resource'>
            <label class='resource-label' for="system.capacity.max">{{localize 'SDM.GearContainer.Capacity'}}</label>
            <div class='resource-content'>
              <input type='text' name="system.capacity.max" value="{{system.capacity.max}}" data-dtype='Number' data-tooltip="{{localize 'SDM.UnitStones'}}"/>
            </div>
          </div>
          {{/if}}

        </div>
        {{/unless}}
      {{/if}}
  </header>
  <header>
    <div class='grid grid-3col'>
    {{#if (ne item.system.size.unit 'cash')}}
      <div class="resource">
        <label class='resource-label '>{{localize 'SDM.ItemGearType'}}</label>
        <select id='gearType' name='system.type' class="resource-content">
          {{selectOptions config.gearType localize=true selected=system.type sort=true blank='TYPE.Gear'}}
        </select>
      </div>

      {{#if (eq item.system.type '')}}

      <div class="resource align-center">
        <label class='resource-label'>{{localize 'SDM.GearStartingKit'}}</label>
        <div class='resource-content align-center'>
          <input type='checkbox' name='system.starting_kit' {{checked system.starting_kit}} />
        </div>
      </div>

        {{#if item.system.starting_kit}}
        <div class="resource">
          <label class='resource-label'>{{localize 'SDM.GearStartingKitRemainingItems'}}</label>
          <div class='resource-content'>
            <input type='text' name='system.packed_remaining_items' value='{{system.packed_remaining_items}}' data-dtype='Number' />
          </div>
        </div>
        {{else}}
        <div class="resource">

        </div>
        {{/if}}

        <div class="resource align-center">
          <label class="resource-label">{{localize 'SDM.InstalledMods'}}</label>
          <div class="resource-content sources flex-group-center mt-5">
            {{#multiboxes item.installedMods}}
              <input type="radio" id="installed-mods-{{item.id}}-0" name="system.installed_mods" value="0" checked="checked" data-dtype='Radio' style="cursor:pointer;" disabled>
              {{#times_from 1 (addOne system.hallmark.level)}}
                <input type="radio" id="installed-mods-{{../item.id}}-{{this}}" name="system.installed_mods" value="{{this}}" data-dtype='Radio' style="cursor:pointer;" disabled/>
                <label class="radio-toggle" for="installed-mods-{{../item.id}}-{{this}}" style="cursor:pointer;" data-tooltip="{{this}}" disabled></label>
              {{/times_from}}
            {{/multiboxes}}
          </div>
        </div>

        <div class="resource align-center">
          <label class='resource-label'>{{localize 'SDM.IsSupply'}}</label>
          <div class='resource-content align-center'>
            <input type='checkbox' name='system.is_supply' {{checked system.is_supply}} />
          </div>
        </div>

        {{#if item.system.is_supply}}
        <div class= "resource">
          <label class='resource-label '>{{localize 'SDM.SupplyType'}}</label>
          <select id='supply_type' name='system.supply_type' class="resource-content">
            {{selectOptions config.SupplyType localize=true selected=system.supply_type sort=true blank=""}}
          </select>
        </div>
        {{/if}}

      {{/if}}

      {{#if (or (eq system.type 'weapon') (has system.features 'weapon'))}}
      <div class='resource'>
        <label class='resource-label'>
          {{localize 'SDM.WeaponDamage'}}
        </label>
        <div class='resource-content'>
          <input type='text' name='system.weapon.damage.base' value='{{system.weapon.damage.base}}' />
        </div>
      </div>
      {{#if system.attack_bonus}}
      <div class='resource' data-tooltip="{{localize 'SDM.ItemAttackBonusHint'}}">
        <label class='resource-label'>{{localize 'SDM.ItemAttackBonus'}}</label>
        <div class='resource-content'><span>{{numberFormat system.attack_bonus sign=true}}</span></div>
      </div>
      {{/if}}
      <div class="resource">
        <label class='resource-label'>{{localize 'SDM.WeaponRange'}}</label>
        <select id='weapon_range' name='system.weapon.range' class="resource-content">
          {{selectOptions config.rangeType localize=true selected=system.weapon.range blank=''}}
        </select>
      </div>
      <div class="resource" data-tooltip="{{localize 'SDM.WeaponSplashHint'}}">
        <label class='resource-label'>{{localize 'SDM.WeaponSplash'}}</label>
        <select name='system.weapon.splash_damage'>{{selectOptions splashDamage localize=true selected=system.weapon.splash_damage}}</select>
        {{#if (eq system.weapon.splash_damage 'formula')}}<input type='text' name='system.weapon.splash' value='{{system.weapon.splash}}' data-tooltip="{{localize 'SDM.WeaponSplashFormulaHint'}}" />{{/if}}
      </div>
      {{#if (or system.weapon.splash (ne system.weapon.splash_damage 'formula'))}}
      <div class="resource">
        <label class='resource-label'>{{localize 'SDM.WeaponSplashShape'}}</label>
        <select name='system.weapon.splash_shape'>{{selectOptions splashShapes localize=true selected=system.weapon.splash_shape}}</select>
        {{#if (ne system.weapon.splash_shape 'around')}}
        <select name='system.weapon.splash_size'>{{selectOptions powerAreaValues localize=true selected=system.weapon.splash_size}}</select>
        <input type='number' name='system.weapon.splash_across' value='{{system.weapon.splash_across}}' min='0' step='any' data-dtype='Number' data-tooltip="{{localize 'SDM.AreaAcrossHint'}}" />
        {{/if}}
        <select name='system.weapon.splash_affects'>{{selectOptions areaAffects localize=true selected=system.weapon.splash_affects}}</select>
      </div>
      {{/if}}

      {{!-- <div class='resource align-center'>
        <label class='resource-label'>
          {{localize 'SDM.WeaponVersatile'}}
        </label>
        <div class='resource-content align-center'>
          <input type='checkbox' name='system.weapon.versatile' {{checked system.weapon.versatile}} />
        </div>
      </div> --}}
      {{#if (has system.features 'weapon')}}
      <div class="resource">
      </div>
      {{else}}
      <div class="resource align-center">
        <label class="resource-label">{{localize 'SDM.InstalledMods'}}</label>
        <div class="resource-content sources flex-group-center mt-5">
          {{#multiboxes item.installedMods}}
            <input type="radio" id="installed-mods-{{item.id}}-0" name="system.installed_mods" value="0" checked="checked" data-dtype='Radio' style="cursor:pointer;" disabled>
            {{#times_from 1 (addOne system.hallmark.level)}}
              <input type="radio" id="installed-mods-{{../item.id}}-{{this}}" name="system.installed_mods" value="{{this}}" data-dtype='Radio' style="cursor:pointer;" disabled/>
              <label class="radio-toggle" for="installed-mods-{{../item.id}}-{{this}}" style="cursor:pointer;" data-tooltip="{{this}}" disabled></label>
            {{/times_from}}
          {{/multiboxes}}
        </div>
      </div>
      {{/if}}

      <div class='resource'>
        {{#if (or system.weapon.versatile (has system.features 'versatile'))}}
        <label class='resource-label'>
          {{localize 'SDM.WeaponVersatileDamage'}}
        </label>
        <div class='resource-content'>
          <input type='text' name='system.weapon.damage.versatile' value='{{system.weapon.damage.versatile}}' />
        </div>
        {{/if}}
      </div>

      {{#if (ne item.parent.type 'npc')}}
      <div class='resource'>
        <label class='resource-label'>
          {{localize 'SDM.AbilityModifier'}}
        </label>
        <div class='resource-content'>
          <select name="system.default_ability" id="system.default_ability">
            <option value=""></option>
            {{selectOptions @root.abilities localize=true selected=system.default_ability}}
          </select>
        </div>
      </div>
      {{/if}}
      {{/if}}



      {{#if (or (eq item.system.type 'armor') (has item.system.features 'armor'))}}
      <div class='resource'>
        <label class='resource-label'>
          {{localize 'SDM.ArmorValue'}}
        </label>
        <div class='resource-content'>
          <input type='text' name='system.armor.value' value='{{system.armor.value}}' data-dtype='Number' />
        </div>
      </div>

      <div class="resource">
        <label class='resource-label'>{{localize 'SDM.ArmorType'}}</label>
        <select name='system.armor.type' class="resource-content">
          <option value=''></option>
          {{selectOptions config.armorType localize=true selected=system.armor.type}}
        </select>
      </div>
      {{/if}}

      {{#if (or (eq item.system.type 'ward') (has item.system.features 'ward'))}}
      <div class='resource'>
        <label class='resource-label'>
          {{localize 'SDM.WardValue'}}
        </label>
        <div class='resource-content'>
          <input type='text' name='system.ward.value' value='{{system.ward.value}}' data-dtype='Number' />
        </div>
      </div>

      <div class="resource">
        <label class='resource-label'>{{localize 'SDM.WardType'}}</label>
        <select name='system.ward.type' class="resource-content">
          <option value=''></option>
          {{selectOptions config.wardType localize=true selected=system.ward.type}}
        </select>
      </div>
      {{/if}}

      {{#unless (or (eq item.system.type '') (eq item.system.type 'weapon'))}}
      <div class="resource align-center">
        <label class="resource-label">{{localize 'SDM.InstalledMods'}}</label>
        <div class="resource-content sources flex-group-center mt-5">
          {{#multiboxes item.installedMods}}
            <input type="radio" id="installed-mods-{{item.id}}-0" name="system.installed_mods" value="0" checked="checked" data-dtype='Radio' style="cursor:pointer;" disabled>
            {{#times_from 1 (addOne system.hallmark.level)}}
              <input type="radio" id="installed-mods-{{../item.id}}-{{this}}" name="system.installed_mods" value="{{this}}" data-dtype='Radio' style="cursor:pointer;" disabled/>
              <label class="radio-toggle" for="installed-mods-{{../item.id}}-{{this}}" style="cursor:pointer;" data-tooltip="{{this}}" disabled></label>
            {{/times_from}}
          {{/multiboxes}}
        </div>
      </div>
      {{/unless}}

      {{#if (eq item.system.type 'power')}}
      {{!-- Start fragment --}}
      {{> ($$ "item/power") item=item abilities=@root.abilities}}
      {{!-- End fragment --}}
      {{/if}}


      {{#if (sdmHasAlbum item)}}
      <div class="resource">
        <label class='resource-label'>
          {{localize 'SDM.GearMaxPowers'}}
        </label>
        <input type='text' name='system.max_powers' value='{{system.max_powers}}' data-dtype='Number' />
      </div>
      <div class="resource"></div>
      {{/if}}
      {{/if}}
    </div>
</div>
</div>
</header>
</div>
