{{! Effects Tab }}
<section class='tab effects scrollable {{tab.cssClass}}' data-group='primary' data-tab='effects'>
  {{!-- Damage boost paid with a resource (weapons) --}}
  {{#if (and (sdmFeature 'boost') (eq item.type 'gear') (or (eq system.type 'weapon') (has system.features 'weapon')))}}
  <div class="sdm-counters sdm-boost">
    <header>
      <label><input type="checkbox" name="system.boost.enabled" {{checked system.boost.enabled}} /> <strong>{{localize 'SDM.Boost.Enabled'}}</strong></label>
    </header>
    {{#if system.boost.enabled}}
    <div class="sdm-counter-row">
      <label>{{localize 'SDM.Boost.Cost'}}
        <input type="text" name="system.boost.cost" value="{{system.boost.cost}}" placeholder="1" data-tooltip="{{localize 'SDM.Boost.CostHint'}}" /></label>
      <label>{{localize 'SDM.Boost.Resource'}}
        <select name="system.boost.resource">{{selectOptions boostResources selected=system.boost.resource localize=true}}</select></label>
      <label data-tooltip="{{localize 'SDM.Boost.MultiplierHint'}}">{{localize 'SDM.Boost.Multiplier'}}
        <input type="number" min="0" name="system.boost.multiplier" value="{{system.boost.multiplier}}" data-dtype="Number" /></label>
      <label data-tooltip="{{localize 'SDM.Boost.ExtraHint'}}">{{localize 'SDM.Boost.Extra'}}
        <input type="text" name="system.boost.extra" value="{{system.boost.extra}}" placeholder="1d6" /></label>
      <label data-tooltip="{{localize 'SDM.Boost.DamageHint'}}">{{localize 'SDM.Boost.Damage'}}
        <input type="text" name="system.boost.damage" value="{{system.boost.damage}}" placeholder="1d12" /></label>
      <label data-tooltip="{{localize 'SDM.Boost.NoteHint'}}">{{localize 'SDM.Boost.Note'}}
        <input class="sdm-counter-label" type="text" name="system.boost.note" value="{{system.boost.note}}" placeholder="{{localize 'SDM.Boost.NotePlaceholder'}}" /></label>
      <label data-tooltip="{{localize 'SDM.Boost.MandatoryHint'}}">
        <input type="checkbox" name="system.boost.mandatory" {{checked system.boost.mandatory}} /> {{localize 'SDM.Boost.MandatoryLabel'}}</label>
    </div>
    {{/if}}
  </div>
  {{/if}}
  {{!-- Roll triggers shown on chat cards (gear, traits and burdens) --}}
  {{#if (and (sdmFeature 'triggers') (or (eq item.type 'gear') (eq item.type 'trait') (eq item.type 'burden')))}}
  <div class="sdm-counters sdm-triggers" data-collapse-key="triggers">
    <header>
      <strong><a class="sdm-collapse-toggle" data-tooltip="{{localize 'SDM.Collapse'}}"><i class="fa-solid fa-chevron-down" inert></i></a> {{localize 'SDM.Trigger.Title'}} <span class="sdm-section-count">({{system.triggers.length}})</span></strong>
      {{#if @root.editable}}<a data-action="addTrigger"><i class="fa-solid fa-plus"></i> {{localize 'SDM.Trigger.New'}}</a>{{/if}}
    </header>
    {{#each system.triggers as |trigger index|}}
    <div class="sdm-trigger">
    <div class="sdm-counter-row">
      <select name="system.triggers.{{index}}.roll">{{selectOptions @root.triggerRolls selected=trigger.roll localize=true}}</select>
      {{#if (eq trigger.roll 'attack')}}
      <select name="system.triggers.{{index}}.attack" data-tooltip="{{localize 'SDM.Trigger.AttackHint'}}">{{selectOptions @root.triggerAttacks selected=trigger.attack localize=true}}</select>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.attack" value="{{trigger.attack}}" />
      {{/if}}
      {{#if (or (eq trigger.roll 'save') (eq trigger.roll 'ability'))}}
      <select name="system.triggers.{{index}}.ability" data-tooltip="{{localize 'SDM.Trigger.AbilityHint'}}">{{selectOptions @root.triggerAbilities selected=trigger.ability localize=true}}</select>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.ability" value="{{trigger.ability}}" />
      {{/if}}
      {{#if (eq trigger.roll 'counter')}}
      <select name="system.triggers.{{index}}.watch_scope" data-tooltip="{{localize 'SDM.Trigger.ScopeHint'}}">{{selectOptions @root.triggerScopes selected=trigger.watch_scope localize=true}}</select>
      <select name="system.triggers.{{index}}.watch" data-tooltip="{{localize 'SDM.Trigger.WatchHint'}}">{{#if (eq trigger.watch_scope 'actor')}}{{selectOptions @root.triggerActorCounters selected=trigger.watch}}{{else}}{{selectOptions @root.triggerCounters selected=trigger.watch}}{{/if}}</select>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.watch_scope" value="{{trigger.watch_scope}}" />
      <input type="hidden" name="system.triggers.{{index}}.watch" value="{{trigger.watch}}" />
      {{/if}}
      {{#if (or (eq trigger.roll 'damage') (eq trigger.roll 'power') (eq trigger.roll 'usage'))}}
      <select name="system.triggers.{{index}}.from" data-tooltip="{{localize 'SDM.Trigger.FromHint'}}">{{selectOptions @root.triggerFrom selected=trigger.from localize=true}}</select>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.from" value="{{trigger.from}}" />
      {{/if}}
      {{#if (and (eq trigger.from 'item') (or (eq trigger.roll 'damage') (eq trigger.roll 'power') (eq trigger.roll 'usage')))}}
      <select name="system.triggers.{{index}}.from_item" data-tooltip="{{localize 'SDM.Trigger.FromItemHint'}}">{{selectOptions @root.triggerSourceItems selected=trigger.from_item}}</select>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.from_item" value="{{trigger.from_item}}" />
      {{/if}}
      {{#if (and (eq trigger.roll 'power') (or (sdmHasAlbum @root.item) trigger.from))}}
      <input type="text" name="system.triggers.{{index}}.power" value="{{trigger.power}}" placeholder="{{localize 'SDM.Trigger.PowerPlaceholder'}}" data-tooltip="{{localize 'SDM.Trigger.PowerHint'}}" />
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.power" value="{{trigger.power}}" />
      {{/if}}
      <select name="system.triggers.{{index}}.condition">{{selectOptions (lookup @root.triggerConditionChoices index) selected=trigger.condition localize=true}}</select>
      {{#if (or (eq trigger.condition 'max') (eq trigger.condition 'min') (eq trigger.condition 'matching') (eq trigger.condition 'runningLow') (eq trigger.condition 'runOut') (eq trigger.condition 'success') (eq trigger.condition 'failure') (eq trigger.condition 'counterMax') (eq trigger.condition 'changes') (eq trigger.condition 'increases') (eq trigger.condition 'decreases') (eq trigger.condition 'full') (eq trigger.condition 'empty'))}}
      <input type="hidden" name="system.triggers.{{index}}.value" value="{{trigger.value}}" data-dtype="Number" />
      {{else}}
      <input type="number" name="system.triggers.{{index}}.value" value="{{trigger.value}}" data-dtype="Number" />
      {{/if}}
      {{#if (or (eq trigger.roll 'counter') (eq trigger.roll 'charges'))}}
      <label class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.ByChangeHint'}}"><input type="checkbox" name="system.triggers.{{index}}.by_change" {{checked trigger.by_change}} /> {{localize 'SDM.Trigger.ByChange'}}</label>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.by_change" value="{{trigger.by_change}}" data-dtype="Boolean" />
      {{/if}}
      {{#if (and (or (eq trigger.roll 'counter') (eq trigger.roll 'charges')) (or (eq trigger.condition 'totalAtLeast') (eq trigger.condition 'totalAtMost')))}}
      <label class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.OnceHint'}}"><input type="checkbox" name="system.triggers.{{index}}.once" {{checked trigger.once}} /> {{localize 'SDM.Trigger.Once'}}</label>
      {{else}}
      <input type="hidden" name="system.triggers.{{index}}.once" value="{{trigger.once}}" data-dtype="Boolean" />
      {{/if}}
      <input class="sdm-counter-label" type="text" name="system.triggers.{{index}}.text" value="{{trigger.text}}" placeholder="{{localize 'SDM.Trigger.TextPlaceholder'}}" />
      {{#if @root.editable}}<a data-action="removeTrigger" data-index="{{index}}" data-tooltip="{{localize 'SDM.Trigger.Remove'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </div>
    <details class="sdm-trigger-actions" {{#if (or trigger.cost_resource trigger.table trigger.effect trigger.wear trigger.counter trigger.cast trigger.use trigger.light trigger.charges_mode)}}open{{/if}}>
      <summary>{{localize 'SDM.Trigger.Actions'}}</summary>
      <div class="sdm-counter-row">
        <label data-tooltip="{{localize 'SDM.Trigger.CostHint'}}">{{localize 'SDM.Trigger.Cost'}}
          <select name="system.triggers.{{index}}.cost_resource">{{selectOptions @root.triggerCostResources selected=trigger.cost_resource localize=true}}</select>
          {{#if trigger.cost_resource}}
          <input class="sdm-trigger-cost" type="text" name="system.triggers.{{index}}.cost" value="{{trigger.cost}}" placeholder="1" data-tooltip="{{localize 'SDM.Trigger.CostFormulaHint'}}" />
          <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.CostAskHint'}}"><input type="checkbox" name="system.triggers.{{index}}.cost_ask" {{checked trigger.cost_ask}} /> {{localize 'SDM.Trigger.CostAsk'}}</span>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.cost" value="{{trigger.cost}}" />
          <input type="hidden" name="system.triggers.{{index}}.cost_ask" value="{{trigger.cost_ask}}" data-dtype="Boolean" />
          {{/if}}</label>
        <label data-tooltip="{{localize 'SDM.Trigger.TableHint'}}">{{localize 'SDM.Trigger.Table'}}
          <input class="sdm-trigger-table" type="text" name="system.triggers.{{index}}.table" value="{{trigger.table}}" placeholder="{{localize 'SDM.Trigger.TablePlaceholder'}}" /></label>
        <label data-tooltip="{{localize 'SDM.Trigger.EffectHint'}}">{{localize 'SDM.Trigger.Effect'}}
          <select name="system.triggers.{{index}}.effect">{{selectOptions @root.triggerEffects selected=trigger.effect}}</select>
          {{!-- Details of an action only show once the action is picked --}}
          {{#if trigger.effect}}
          <select name="system.triggers.{{index}}.effect_target">{{selectOptions @root.triggerEffectTargets selected=trigger.effect_target localize=true}}</select>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.effect_target" value="{{trigger.effect_target}}" />
          {{/if}}</label>
        <label>{{localize 'SDM.Trigger.WearLabel'}}
          <select name="system.triggers.{{index}}.wear">{{selectOptions @root.triggerWear selected=trigger.wear localize=true}}</select></label>
        <label>{{localize 'SDM.Trigger.Counter'}}
          <select name="system.triggers.{{index}}.counter_scope" data-tooltip="{{localize 'SDM.Trigger.ScopeHint'}}">{{selectOptions @root.triggerScopes selected=trigger.counter_scope localize=true}}</select>
          <select name="system.triggers.{{index}}.counter">{{#if (eq trigger.counter_scope 'actor')}}{{selectOptions @root.triggerActorCounters selected=trigger.counter}}{{else}}{{selectOptions @root.triggerCounters selected=trigger.counter}}{{/if}}</select>
          {{#if trigger.counter}}
          <select name="system.triggers.{{index}}.counter_mode">{{selectOptions @root.triggerCounterModes selected=trigger.counter_mode localize=true}}</select>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.counter_mode" value="{{trigger.counter_mode}}" />
          {{/if}}
          {{#if (or (not trigger.counter) (eq trigger.counter_mode 'reset'))}}
          <input type="hidden" name="system.triggers.{{index}}.counter_step" value="{{trigger.counter_step}}" data-dtype="Number" />
          {{else}}
          <input type="number" name="system.triggers.{{index}}.counter_step" value="{{trigger.counter_step}}" data-dtype="Number" data-tooltip="{{localize 'SDM.Trigger.CounterStepHint'}}" />
          {{/if}}</label>
        <label data-tooltip="{{localize 'SDM.Trigger.CastHint'}}">{{localize 'SDM.Trigger.Cast'}}
          <select name="system.triggers.{{index}}.cast">{{selectOptions @root.triggerCastItems selected=trigger.cast}}</select>
          {{#if trigger.cast}}
          <input type="text" name="system.triggers.{{index}}.cast_power" value="{{trigger.cast_power}}" placeholder="{{localize 'SDM.Trigger.CastPowerPlaceholder'}}" data-tooltip="{{localize 'SDM.Trigger.CastPowerHint'}}" />
          <span class="sdm-trigger-check" data-tooltip="{{localize 'SDM.Trigger.CastFreeHint'}}"><input type="checkbox" name="system.triggers.{{index}}.cast_free" {{checked trigger.cast_free}} /> {{localize 'SDM.Trigger.CastFree'}}</span>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.cast_power" value="{{trigger.cast_power}}" />
          <input type="hidden" name="system.triggers.{{index}}.cast_free" value="{{trigger.cast_free}}" data-dtype="Boolean" />
          {{/if}}</label>
        <label data-tooltip="{{localize 'SDM.Trigger.ChargesHint'}}">{{localize 'SDM.Trigger.Charges'}}
          <select name="system.triggers.{{index}}.charges_mode">{{selectOptions @root.triggerChargeModes selected=trigger.charges_mode localize=true}}</select>
          {{#if trigger.charges_mode}}
          <input type="number" min="0" name="system.triggers.{{index}}.charges_amount" value="{{trigger.charges_amount}}" data-dtype="Number" />
          <select name="system.triggers.{{index}}.charges_item">{{selectOptions @root.triggerChargeItems selected=trigger.charges_item}}</select>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.charges_amount" value="{{trigger.charges_amount}}" data-dtype="Number" />
          <input type="hidden" name="system.triggers.{{index}}.charges_item" value="{{trigger.charges_item}}" />
          {{/if}}</label>
        <label data-tooltip="{{localize 'SDM.Trigger.UseHint'}}">{{localize 'SDM.Trigger.Use'}}
          <select name="system.triggers.{{index}}.use">{{selectOptions @root.triggerUseItems selected=trigger.use}}</select></label>
        {{#if (sdmFeature 'lights')}}
        <label data-tooltip="{{localize 'SDM.Trigger.LightHint'}}">{{localize 'SDM.Trigger.Light'}}
          <select name="system.triggers.{{index}}.light">{{selectOptions @root.triggerLightModes selected=trigger.light localize=true}}</select>
          {{#if trigger.light}}
          <select name="system.triggers.{{index}}.light_item">{{selectOptions @root.triggerLightItems selected=trigger.light_item}}</select>
          {{else}}
          <input type="hidden" name="system.triggers.{{index}}.light_item" value="{{trigger.light_item}}" />
          {{/if}}</label>
        {{else}}
        <input type="hidden" name="system.triggers.{{index}}.light" value="{{trigger.light}}" />
        <input type="hidden" name="system.triggers.{{index}}.light_item" value="{{trigger.light_item}}" />
        {{/if}}
      </div>
    </details>
    </div>
    {{else}}
    <p class="hint">{{localize 'SDM.Trigger.None'}}</p>
    {{/each}}
  </div>
  {{/if}}
  {{> ($$ "counters")}}
  <ol class='effects-list'>
    {{#each effects as |section sid|}}
    <li class='effects-header flexrow' data-effect-type='{{section.type}}'>
      <div class='effect-name effect-name flexrow'>
        {{localize section.label}}
      </div>
      <div class='effect-source'>
        {{localize 'SDM.Effect.Source'}}
      </div>
      <div class='effect-source'>{{localize 'EFFECT.TabDuration'}}</div>
      <div class='effect-controls effect-controls flexrow'>
        <a class='effect-control' data-action='createDoc' data-document-class='ActiveEffect'
          data-origin="{{@root.item.uuid}}" data-img="icons/svg/aura.svg" {{#if (eq section.type "inactive" )}}
          data-disabled="true" {{else if (eq section.type "temporary" )}} data-duration.value="1" data-duration.units="rounds" data-duration.expiry="turnStart" {{/if}}
          data-tooltip='{{localize "SDM.DOCUMENT.Create" type=(localize 'TYPE.Effect')}}'>
          <i class='fa-solid fa-plus'></i>
          {{localize 'SDM.DOCUMENT.New' type=(localize 'TYPE.Effect')}}
        </a>
      </div>
    </li>
    <ol class='effect-list'>
      {{#each section.effects as |effect|}}
      <li class='item effect flexrow' data-effect-id='{{effect.id}}' data-parent-id='{{effect.parent.id}}'
        data-drag="true">
        <div class='effect-name effect-name flexrow'>
          <img class='effect-image' src='{{effect.img}}' height="24" width="24" />
          <div>{{effect.name}}</div>
        </div>
        <div class='effect-source'>{{effect.sourceName}}</div>
        <div class='effect-duration{{#if effect.duration.expired}} expired{{/if}}'>{{#if effect.duration.expired}}{{localize 'SDM.Effect.Expired'}}{{else}}{{effect.duration.label}}{{/if}}</div>
        <div class='effect-controls effect-controls flexrow'>
          {{#if @root.editable}}
          <a class='effect-control' data-action='toggleEffect' data-tooltip='{{localize "SDM.Effect.Toggle"}}'>
            <i class='fa-solid {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}'></i>
          </a>
          {{/if}}
          <a class='effect-control' data-action='viewDoc' data-document-class='ActiveEffect'
            data-tooltip='{{localize "DOCUMENT.Update" type=(localize 'TYPE.Effect')}}'>
            <i class='fa-solid fa-edit'></i>
          </a>
          {{#if @root.isGM}}
          {{#if @root.editable}}
          <a class='effect-control' data-action='deleteDoc' data-document-class='ActiveEffect'
            data-tooltip='{{localize "DOCUMENT.Delete" type=(localize 'TYPE.Effect')}}'>
            <i class='fa-solid fa-trash'></i>
          </a>
          {{/if}}
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
    {{/each}}
  </ol>
  {{#if itemReference}}
  <div class="sdm-item-reference hint">
    <p>
      {{localize 'SDM.Effect.ItemReference'}}
      <code>{{itemReference.reference}}</code>
      <a data-action="copyItemReference" data-tooltip="{{localize 'SDM.Effect.CopyItemReference'}}"><i class="fa-solid fa-copy"></i></a>
    </p>
  </div>
  {{/if}}
</section>
