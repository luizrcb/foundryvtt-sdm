{{! Item sheet v2: gear fields grouped in cards. Same field names and conditions as item/gear/header. }}
{{! Card order: item type, inventory (or pet), then the rest. }}
{{#if (ne system.size.unit 'cash')}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'SDM.ItemGearType'}}</span>
  <div class="v2-fields">
    <label class="v2-field" aria-label="{{localize 'SDM.ItemGearType'}}">
      <select id="gearType" name="system.type">
        {{selectOptions config.gearType localize=true selected=system.type sort=true blank='TYPE.Gear'}}
      </select>
    </label>
    {{#if (eq system.type '')}}
    <label class="v2-field v2-check">
      <input type="checkbox" name="system.starting_kit" {{checked system.starting_kit}} />
      <span class="v2-label">{{localize 'SDM.GearStartingKit'}}</span>
    </label>
    {{#if system.starting_kit}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.GearStartingKitRemainingItems'}}</span>
      <input type="text" name="system.packed_remaining_items" value="{{system.packed_remaining_items}}" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field v2-check">
      <input type="checkbox" name="system.is_supply" {{checked system.is_supply}} />
      <span class="v2-label">{{localize 'SDM.IsSupply'}}</span>
    </label>
    {{#if system.is_supply}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SupplyType'}}</span>
      <select name="system.supply_type">
        {{selectOptions config.SupplyType localize=true selected=system.supply_type sort=true blank=""}}
      </select>
    </label>
    {{/if}}
    {{/if}}
    {{#if (sdmHasAlbum item)}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.GearMaxPowers'}}</span>
      <input type="text" name="system.max_powers" value="{{system.max_powers}}" data-dtype="Number" />
    </label>
    {{/if}}
    {{#if v2.showMods}}{{> ($$ "item/v2/installed-mods")}}{{/if}}
  </div>
</section>
{{/if}}

{{#if (eq system.type 'pet')}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'TYPES.Item.pet'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemSizeValue'}}</span>
      <input type="text" name="system.size.value" value="{{system.size.value}}" data-dtype="Number" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemSizeUnit'}}</span>
      <select name="system.size.unit">
        <option value=""></option>
        {{selectOptions sizeUnits localize=true selected=system.size.unit}}
      </select>
    </label>
    {{> ($$ "item/v2/pet-link")}}
  </div>
</section>
{{else}}
{{#unless (or (eq system.type 'corruption') (eq system.type 'affliction') (eq system.type 'augment'))}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'SDM.TabInventory'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemQuantity'}}</span>
      <input type="text" name="system.quantity" value="{{system.quantity}}" data-dtype="Number"
        {{#if (eq system.type 'container')}}disabled{{/if}} />
    </label>
    {{#unless (eq system.size.unit 'cash')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemCost'}}</span>
      <input type="text" name="system.cost" value="{{system.cost}}" data-dtype="Number" />
    </label>
    {{/unless}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemSizeValue'}}</span>
      <input type="text" name="system.size.value" value="{{system.size.value}}" data-dtype="Number" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemSizeUnit'}}</span>
      <select name="system.size.unit">
        <option value=""></option>
        {{selectOptions sizeUnits localize=true selected=system.size.unit}}
      </select>
    </label>
    {{#if (eq system.type 'container')}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.UnitStones'}}">
      <span class="v2-label">{{localize 'SDM.GearContainer.Capacity'}}</span>
      <input type="text" name="system.capacity.max" value="{{system.capacity.max}}" data-dtype="Number" />
    </label>
    {{/if}}
  </div>
</section>
{{/unless}}
{{/if}}

{{#if (ne system.size.unit 'cash')}}
{{#if v2.isWeapon}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'TYPES.Item.weapon'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WeaponDamage'}}</span>
      <input type="text" name="system.weapon.damage.base" value="{{system.weapon.damage.base}}" />
    </label>
    {{#if system.attack_bonus}}
    <span class="v2-field" data-tooltip="{{localize 'SDM.ItemAttackBonusHint'}}">
      <span class="v2-label">{{localize 'SDM.ItemAttackBonus'}}</span>
      <span>{{numberFormat system.attack_bonus sign=true}}</span>
    </span>
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WeaponRange'}}</span>
      <select name="system.weapon.range">
        {{selectOptions config.rangeType localize=true selected=system.weapon.range blank=''}}
      </select>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.WeaponSplashHint'}}">
      <span class="v2-label">{{localize 'SDM.WeaponSplash'}}</span>
      <select name="system.weapon.splash_damage">{{selectOptions splashDamage localize=true selected=system.weapon.splash_damage}}</select>
    </label>
    {{#if (eq system.weapon.splash_damage 'formula')}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.WeaponSplashFormulaHint'}}">
      <span class="v2-label">{{localize 'SDM.WeaponSplashFormula'}}</span>
      <input type="text" name="system.weapon.splash" value="{{system.weapon.splash}}" />
    </label>
    {{/if}}
    {{#if (or system.weapon.splash (ne system.weapon.splash_damage 'formula'))}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WeaponSplashShape'}}</span>
      <select name="system.weapon.splash_shape">{{selectOptions splashShapes localize=true selected=system.weapon.splash_shape}}</select>
    </label>
    {{#if (ne system.weapon.splash_shape 'around')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WeaponSplashSize'}}</span>
      <select name="system.weapon.splash_size">{{selectOptions powerAreaValues localize=true selected=system.weapon.splash_size}}</select>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaAcrossHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaAcross'}}</span>
      <input type="number" name="system.weapon.splash_across" value="{{system.weapon.splash_across}}" min="0" step="any" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaAffects.Label'}}</span>
      <select name="system.weapon.splash_affects">{{selectOptions areaAffects localize=true selected=system.weapon.splash_affects}}</select>
    </label>
    {{/if}}
    {{#if (or system.weapon.versatile (has system.features 'versatile'))}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WeaponVersatileDamage'}}</span>
      <input type="text" name="system.weapon.damage.versatile" value="{{system.weapon.damage.versatile}}" />
    </label>
    {{/if}}
    {{#if (ne item.parent.type 'npc')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AbilityModifier'}}</span>
      <select name="system.default_ability">
        <option value=""></option>
        {{selectOptions @root.abilities localize=true selected=system.default_ability}}
      </select>
    </label>
    {{/if}}
  </div>
</section>
{{/if}}

{{#if v2.isArmor}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'TYPES.Item.armor'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ArmorValue'}}</span>
      <input type="text" name="system.armor.value" value="{{system.armor.value}}" data-dtype="Number" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ArmorType'}}</span>
      <select name="system.armor.type">
        <option value=""></option>
        {{selectOptions config.armorType localize=true selected=system.armor.type}}
      </select>
    </label>
  </div>
</section>
{{/if}}

{{#if v2.isWard}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'TYPES.Item.ward'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WardValue'}}</span>
      <input type="text" name="system.ward.value" value="{{system.ward.value}}" data-dtype="Number" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.WardType'}}</span>
      <select name="system.ward.type">
        <option value=""></option>
        {{selectOptions config.wardType localize=true selected=system.ward.type}}
      </select>
    </label>
  </div>
</section>
{{/if}}

{{#if (eq system.type 'power')}}{{> ($$ "item/v2/power")}}{{/if}}
{{/if}}

{{#if (eq system.type 'affliction')}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'TYPES.Item.affliction'}}</span>
  <div class="v2-fields">{{> ($$ "item/v2/cure-steps")}}</div>
</section>
{{/if}}

{{#if v2.hasFeatureFields}}
<section class="v2-card v2-item-card">
  <span class="v2-card-title">{{localize 'SDM.ItemTabFeatures'}}</span>
  <div class="v2-fields">
    {{#unless (or (eq system.size.unit 'cash') (eq system.type 'corruption') (eq system.type 'affliction') (not (has system.features 'charges')))}}
    <div class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemCharges'}}</span>
      <div class="v2-pair">
        <input type="text" name="system.charges.value" value="{{system.charges.value}}" data-dtype="Number" data-tooltip="{{localize 'SDM.ItemCharges'}}" />
        <span>/</span>
        <input type="text" name="system.charges.max" value="{{system.charges.max}}" data-dtype="Number" data-tooltip="{{localize 'SDM.ItemMaxCharges'}}" />
      </div>
    </div>
    {{/unless}}
    {{#if v2.isWeapon}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.WorksWhenRunOutHint'}}">
      <input type="checkbox" name="system.works_when_run_out" {{checked system.works_when_run_out}} />
      <span class="v2-label">{{localize 'SDM.WorksWhenRunOut'}}</span>
    </label>
    {{/if}}
    {{#if (has system.features 'area')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.area'}}</span>
      <select name="system.area.value" data-tooltip="{{localize 'SDM.ItemFeature.areaDescription'}}">
        {{selectOptions areaValues localize=true selected=system.area.value blank=''}}
      </select>
    </label>
    {{#if (and system.area.value (ne system.area.value 'single'))}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaShape.Label'}}</span>
      <select name="system.area.shape">{{selectOptions areaShapes localize=true selected=system.area.shape}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaAffects.Label'}}</span>
      <select name="system.area.affects">{{selectOptions areaAffects localize=true selected=system.area.affects}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaResolve.Label'}}</span>
      <select name="system.area.resolve">{{selectOptions @root.areaResolve localize=true selected=system.area.resolve}}</select>
    </label>
    {{#if (eq system.area.resolve 'save')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaSaveAbility'}}</span>
      <select name="system.area.save_ability">{{selectOptions @root.areaSaveAbilities localize=true selected=system.area.save_ability}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SaveDifficulty.Feature'}}</span>
      <select name="system.area.save_difficulty">{{selectOptions @root.areaSaveDifficulties localize=true selected=system.area.save_difficulty}}</select>
    </label>
    {{#if (eq system.area.save_difficulty 'target')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SaveDifficulty.target'}}</span>
      <input type="number" name="system.area.save_target" value="{{system.area.save_target}}" min="1" step="1" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaSavePass.Label'}}</span>
      <select name="system.area.save_pass">{{selectOptions @root.areaSavePass localize=true selected=system.area.save_pass}}</select>
    </label>
    {{/if}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaLingerHint'}}">
      <input type="checkbox" name="system.area.linger" {{checked system.area.linger}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaLinger'}}</span>
    </label>
    {{#if system.area.linger}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundsHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRounds'}}</span>
      <input type="number" name="system.area.rounds" value="{{system.area.rounds}}" min="0" step="1" data-dtype="Number" />
    </label>
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaFollowsHint'}}">
      <input type="checkbox" name="system.area.follows" {{checked system.area.follows}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaFollows'}}</span>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundDamageHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundDamage.Label'}}</span>
      <select name="system.area.round_damage">{{selectOptions @root.areaRoundDamage localize=true selected=system.area.round_damage}}</select>
    </label>
    {{#if (eq system.area.round_damage 'formula')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaRoundFormula'}}</span>
      <input type="text" name="system.area.round_formula" value="{{system.area.round_formula}}" />
    </label>
    {{/if}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaRoundEnterHint'}}">
      <input type="checkbox" name="system.area.round_enter" {{checked system.area.round_enter}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaRoundEnter'}}</span>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundConditionHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundCondition'}}</span>
      <select name="system.area.round_condition">{{selectOptions @root.triggerStatuses selected=system.area.round_condition}}</select>
    </label>
    {{#if system.area.round_condition}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundConditionRoundsHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundConditionRounds'}}</span>
      <input type="number" name="system.area.round_condition_rounds" value="{{system.area.round_condition_rounds}}" min="0" step="1" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaLightHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaLight'}}</span>
      <select name="system.area.light">{{selectOptions @root.areaLights localize=true selected=system.area.light}}</select>
    </label>
    {{/if}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaAcrossHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaAcross'}}</span>
      <input type="number" name="system.area.across" value="{{system.area.across}}" min="0" step="any" data-dtype="Number" />
    </label>
    {{#if (or (eq system.area.shape 'line') (eq system.area.shape 'ring'))}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaWidthHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaWidth'}}</span>
      <input type="number" name="system.area.width" value="{{system.area.width}}" min="0" step="any" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaVehicleHint'}}">
      <input type="checkbox" name="system.area.vehicle" {{checked system.area.vehicle}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaVehicle'}}</span>
    </label>
    {{/if}}
    {{/if}}
    {{#if (has system.features 'range')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.range'}}</span>
      <select name="system.range.value" data-tooltip="{{localize 'SDM.ItemFeature.rangeDescription'}}">
        {{selectOptions rangeValues localize=true selected=system.range.value blank=''}}
      </select>
    </label>
    {{/if}}
    {{#if (or (has system.features 'entangling') (has system.features 'petrifying') (has system.features 'heat'))}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SaveDifficulty.Feature'}}</span>
      <select name="system.feature_save" data-tooltip="{{localize 'SDM.SaveDifficulty.FeatureHint'}}">{{selectOptions @root.triggerSaveDifficulties selected=system.feature_save localize=true}}</select>{{#if (eq system.feature_save 'target')}}<input type="number" min="1" step="1" name="system.feature_save_target" value="{{system.feature_save_target}}" style="max-width:4em" data-tooltip="{{localize 'SDM.SaveDifficulty.TargetHint'}}" />{{/if}}
    </label>
    {{/if}}
    {{#if (has system.features 'flare')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.flare'}}</span>
      <input type="text" name="system.flare.value" value="{{system.flare.value}}" data-dtype="Number" data-tooltip="{{localize 'SDM.ItemFeature.flareDescription'}}" />
    </label>
    {{/if}}
    {{#if (has system.features 'pocket')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.pocket'}}</span>
      <input type="text" name="system.pocket.value" value="{{system.pocket.value}}" data-dtype="Number" data-tooltip="{{localize 'SDM.ItemFeature.pocketDescription'}}" />
    </label>
    {{/if}}
    {{#if (has system.features 'replenish')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.replenish'}}</span>
      <input type="text" name="system.replenish.value" value="{{system.replenish.value}}" data-dtype="Number" data-tooltip="{{localize 'SDM.ItemFeature.replenishDescription'}}" />
    </label>
    {{#if (or (eq system.type 'weapon') (has system.features 'weapon'))}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.Replenish.OnAttackHint'}}">
      <input type="checkbox" name="system.replenish.on_attack" {{checked system.replenish.on_attack}} />
      <span class="v2-label">{{localize 'SDM.Replenish.OnAttack'}}</span>
    </label>
    {{/if}}
    {{/if}}
    {{#if (has system.features 'resistant')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.resistant'}}</span>
      <input type="text" name="system.resistant.value" value="{{system.resistant.value}}" data-tooltip="{{localize 'SDM.ItemFeature.resistantDescription'}}" />
    </label>
    {{/if}}
    {{#if (sdmIsLight item)}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Label'}}</span>
      <select name="system.light.preset" data-tooltip="{{localize 'SDM.Light.PresetHint'}}">
        {{selectOptions @root.lightPresets selected=system.light.preset localize=true}}
      </select>
    </label>
    {{#if (eq system.light.preset 'custom')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Bright'}}</span>
      <input type="number" name="system.light.bright" value="{{system.light.bright}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Dim'}}</span>
      <input type="number" name="system.light.dim" value="{{system.light.dim}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}" />
    </label>
    <div class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Color'}}</span>
      <color-picker name="system.light.color" value="{{system.light.color}}"></color-picker>
    </div>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Animation'}}</span>
      <select name="system.light.animation">
        {{selectOptions @root.lightAnimations selected=system.light.animation localize=true}}
      </select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Speed'}}</span>
      <input type="number" name="system.light.speed" value="{{system.light.speed}}" min="0" max="10" step="1" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Intensity'}}</span>
      <input type="number" name="system.light.intensity" value="{{system.light.intensity}}" min="0" max="10" step="1" />
    </label>
    {{/if}}
    {{/if}}
  </div>
</section>
{{/if}}

{{!-- Consumable: what Use does (its own card, apart from the feature values) --}}
{{#if (has system.features 'consumable')}}
<section class="v2-card v2-item-card v2-use-card">
  <span class="v2-card-title">{{localize 'SDM.Use.CardTitle'}}</span>
  <div class="v2-fields v2-use-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.Life'}}</span>
      <input type="text" name="system.use.life" value="{{system.use.life}}" data-tooltip="{{localize 'SDM.Use.LifeHint'}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.Ability'}}</span>
      <input type="text" name="system.use.ability" value="{{system.use.ability}}" data-tooltip="{{localize 'SDM.Use.AbilityHint'}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.GroupLabel'}}</span>
      <select name="system.use.ability_group" data-tooltip="{{localize 'SDM.Use.GroupHint'}}">{{selectOptions @root.useAbilityGroups selected=system.use.ability_group localize=true}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.TempLifeLabel'}}</span>
      <input type="text" name="system.use.temp_life" value="{{system.use.temp_life}}" data-tooltip="{{localize 'SDM.Use.TempLifeHint'}}" />
    </label>
  </div>
  <span class="v2-use-group">{{localize 'SDM.Use.CardAlways'}}</span>
  <div class="v2-fields v2-use-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.HarmLabel'}}</span>
      <input type="text" name="system.use.harm" value="{{system.use.harm}}" data-tooltip="{{localize 'SDM.Use.HarmHint'}}" />
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.Use.CuresHint'}}">
      <span class="v2-label">{{localize 'SDM.Use.CuresLabel'}}</span>
      <multi-select name="system.use.cures">{{selectOptions @root.useCureChoices selected=system.use.cures}}</multi-select>
    </label>
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.Use.RestHint'}}">
      <input type="checkbox" name="system.use.rest" {{checked system.use.rest}} />
      <span class="v2-label">{{localize 'SDM.Use.RestLabel'}}</span>
    </label>
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.Use.PurgeHint'}}">
      <input type="checkbox" name="system.use.purge" {{checked system.use.purge}} />
      <span class="v2-label">{{localize 'SDM.Use.PurgeLabel'}}</span>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.Use.ReplenishesHint'}}">
      <span class="v2-label">{{localize 'SDM.Use.ReplenishesLabel'}}</span>
      <select name="system.use.replenishes">{{selectOptions (sdmReplenishChoices) selected=system.use.replenishes localize=true}}</select>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.Use.ForHint'}}">
      <span class="v2-label">{{localize 'SDM.Use.ForLabel'}}</span>
      <input type="text" name="system.use.for" value="{{system.use.for}}" />
    </label>
    <div class="v2-span-2 sdm-use-actions sdm-triggers" data-tooltip="{{localize 'SDM.Use.ActionsHint'}}">
      {{> ($$ "item/trigger-actions") trigger=system.use.actions index="use" prefix="system.use.actions."}}
    </div>
    <div class="v2-field v2-span-2" data-tooltip="{{localize 'SDM.Use.OverdoseHint'}}">
      <span class="v2-label">{{localize 'SDM.Use.OverdoseLabel'}}</span>
      <div class="v2-pair">
        <select name="system.use.overdose.status">{{selectOptions @root.triggerStatuses selected=system.use.overdose.status}}</select>
        <select name="system.use.overdose.effect">{{selectOptions @root.triggerEffects selected=system.use.overdose.effect}}</select>
      </div>
      {{#if (or system.use.overdose.status system.use.overdose.effect)}}
      <div class="v2-pair">
        <input type="number" min="0" step="1" name="system.use.overdose.after" value="{{system.use.overdose.after}}" data-dtype="Number" data-tooltip="{{localize 'SDM.Use.OverdoseAfterHint'}}" />
        <select name="system.use.overdose.period">{{selectOptions @root.useOverduePeriods selected=system.use.overdose.period localize=true}}</select>
        <select name="system.use.overdose.ability">{{selectOptions @root.triggerSaveAbilities selected=system.use.overdose.ability localize=true}}</select>
        <select name="system.use.overdose.difficulty">{{selectOptions @root.useOverdoseDifficulties selected=system.use.overdose.difficulty localize=true}}</select>
        <label class="v2-check" data-tooltip="{{localize 'SDM.Use.OverdoseEscalateHint'}}"><input type="checkbox" name="system.use.overdose.escalate" {{checked system.use.overdose.escalate}} /> {{localize 'SDM.Use.OverdoseEscalate'}}</label>
      </div>
      {{/if}}
    </div>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Use.TableLabel'}}</span>
      <input class="sdm-trigger-table" type="text" name="system.use.table" value="{{system.use.table}}" placeholder="{{localize 'SDM.Trigger.TablePlaceholder'}}" data-tooltip="{{localize 'SDM.Use.TableHint'}}" />
    </label>
    <div class="v2-field v2-span-2" data-tooltip="{{localize 'SDM.Use.DurationHint'}}">
      <span class="v2-label">{{localize 'SDM.Use.DurationLabel'}}</span>
      <div class="v2-pair">
        <input type="number" min="0" name="system.use.duration.value" value="{{system.use.duration.value}}" data-dtype="Number" />
        <select name="system.use.duration.units">{{selectOptions @root.useDurationUnits selected=system.use.duration.units localize=true}}</select>
      </div>
    </div>
  </div>
</section>
{{/if}}

{{> ($$ "item/v2/hallmark")}}

