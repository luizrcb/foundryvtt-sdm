{{! Item sheet v2: power fields (same names as item/power) }}
<section class="v2-card v2-item-card is-wide">
  <span class="v2-card-title">{{localize 'TYPES.Item.power'}}</span>
  <div class="v2-fields">
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerLevel'}}</span>
      <input type="text" name="system.power.level" value="{{system.power.level}}" data-dtype="Number" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerRange'}}</span>
      <input type="text" name="system.power.range" value="{{system.power.range}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerTarget'}}</span>
      <input type="text" name="system.power.target" value="{{system.power.target}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.ItemFeature.area'}}</span>
      <select name="system.power.area">{{selectOptions @root.powerAreaValues localize=true selected=system.power.area blank=''}}</select>
    </label>
    {{#if system.power.area}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaShape.Label'}}</span>
      <select name="system.power.area_shape">{{selectOptions @root.areaShapes localize=true selected=system.power.area_shape}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaAffects.Label'}}</span>
      <select name="system.power.area_affects">{{selectOptions @root.areaAffects localize=true selected=system.power.area_affects}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaResolve.Label'}}</span>
      <select name="system.power.area_resolve">{{selectOptions @root.areaResolve localize=true selected=system.power.area_resolve}}</select>
    </label>
    {{#if (eq system.power.area_resolve 'save')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaSaveAbility'}}</span>
      <select name="system.power.area_save_ability">{{selectOptions @root.areaSaveAbilities localize=true selected=system.power.area_save_ability}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SaveDifficulty.Feature'}}</span>
      <select name="system.power.area_save_difficulty">{{selectOptions @root.areaSaveDifficulties localize=true selected=system.power.area_save_difficulty}}</select>
    </label>
    {{#if (eq system.power.area_save_difficulty 'target')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.SaveDifficulty.target'}}</span>
      <input type="number" name="system.power.area_save_target" value="{{system.power.area_save_target}}" min="1" step="1" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaSavePass.Label'}}</span>
      <select name="system.power.area_save_pass">{{selectOptions @root.areaSavePass localize=true selected=system.power.area_save_pass}}</select>
    </label>
    {{/if}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaLingerHint'}}">
      <input type="checkbox" name="system.power.area_linger" {{checked system.power.area_linger}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaLinger'}}</span>
    </label>
    {{#if system.power.area_linger}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundsHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRounds'}}</span>
      <input type="number" name="system.power.area_rounds" value="{{system.power.area_rounds}}" min="0" step="1" data-dtype="Number" />
    </label>
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaFollowsHint'}}">
      <input type="checkbox" name="system.power.area_follows" {{checked system.power.area_follows}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaFollows'}}</span>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundDamageHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundDamage.Label'}}</span>
      <select name="system.power.area_round_damage">{{selectOptions @root.areaRoundDamage localize=true selected=system.power.area_round_damage}}</select>
    </label>
    {{#if (eq system.power.area_round_damage 'formula')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AreaRoundFormula'}}</span>
      <input type="text" name="system.power.area_round_formula" value="{{system.power.area_round_formula}}" />
    </label>
    {{/if}}
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.AreaRoundEnterHint'}}">
      <input type="checkbox" name="system.power.area_round_enter" {{checked system.power.area_round_enter}} data-dtype="Boolean" />
      <span class="v2-label">{{localize 'SDM.AreaRoundEnter'}}</span>
    </label>
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundConditionHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundCondition'}}</span>
      <select name="system.power.area_round_condition">{{selectOptions @root.triggerStatuses selected=system.power.area_round_condition}}</select>
    </label>
    {{#if system.power.area_round_condition}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaRoundConditionRoundsHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaRoundConditionRounds'}}</span>
      <input type="number" name="system.power.area_round_condition_rounds" value="{{system.power.area_round_condition_rounds}}" min="0" step="1" data-dtype="Number" />
    </label>
    {{/if}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaLightHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaLight'}}</span>
      <select name="system.power.area_light">{{selectOptions @root.areaLights localize=true selected=system.power.area_light}}</select>
    </label>
    {{/if}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaAcrossHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaAcross'}}</span>
      <input type="number" name="system.power.area_across" value="{{system.power.area_across}}" min="0" step="any" data-dtype="Number" />
    </label>
    {{#if (or (eq system.power.area_shape 'line') (eq system.power.area_shape 'ring'))}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.AreaWidthHint'}}">
      <span class="v2-label">{{localize 'SDM.AreaWidth'}}</span>
      <input type="number" name="system.power.area_width" value="{{system.power.area_width}}" min="0" step="any" data-dtype="Number" />
    </label>
    {{/if}}
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerDuration'}}</span>
      <input type="text" name="system.power.duration" value="{{system.power.duration}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerRollFormula'}}</span>
      <input type="text" name="system.power.roll_formula" value="{{system.power.roll_formula}}" />
    </label>
    {{#if (ne item.parent.type 'npc')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.AbilityModifier'}}</span>
      <select name="system.power.default_ability">
        <option value=""></option>
        {{selectOptions @root.abilities localize=true selected=system.power.default_ability}}
      </select>
    </label>
    {{/if}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.PowerOverchargeRollFormula'}}</span>
      <input type="text" name="system.power.overcharge_roll_formula" value="{{system.power.overcharge_roll_formula}}" />
    </label>
    <label class="v2-field v2-check">
      <input type="checkbox" name="system.power.is_dangerous" {{checked system.power.is_dangerous}} />
      <span class="v2-label">{{localize 'SDM.PowerIsDangerous'}}</span>
    </label>
    <label class="v2-field v2-check" data-tooltip="{{localize 'SDM.SingleUse.Hint'}}">
      <input type="checkbox" name="system.power.single_use" {{checked system.power.single_use}} />
      <span class="v2-label"><i class="fa-solid fa-triangle-exclamation"></i> {{localize 'SDM.SingleUse.Label'}}</span>
    </label>
    {{#if (sdmFeature 'lights')}}
    <label class="v2-field" data-tooltip="{{localize 'SDM.Light.PowerHint'}}">
      <span class="v2-label"><i class="fa-solid fa-fire-flame-curved"></i> {{localize 'SDM.Light.Label'}}</span>
      <select name="system.power.light.preset">
        {{selectOptions @root.powerLightPresets selected=system.power.light.preset localize=true}}
      </select>
    </label>
    {{#if (eq system.power.light.preset 'custom')}}
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Bright'}}</span>
      <input type="number" name="system.power.light.bright" value="{{system.power.light.bright}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Dim'}}</span>
      <input type="number" name="system.power.light.dim" value="{{system.power.light.dim}}" min="0" step="any" data-tooltip="{{localize 'SDM.Light.RadiusHint'}}" />
    </label>
    <div class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Color'}}</span>
      <color-picker name="system.power.light.color" value="{{system.power.light.color}}"></color-picker>
    </div>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Animation'}}</span>
      <select name="system.power.light.animation">{{selectOptions @root.lightAnimations selected=system.power.light.animation localize=true}}</select>
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Speed'}}</span>
      <input type="number" name="system.power.light.speed" value="{{system.power.light.speed}}" min="0" max="10" step="1" />
    </label>
    <label class="v2-field">
      <span class="v2-label">{{localize 'SDM.Light.Intensity'}}</span>
      <input type="number" name="system.power.light.intensity" value="{{system.power.light.intensity}}" min="0" max="10" step="1" />
    </label>
    {{/if}}
    {{/if}}
    <label class="v2-field v2-span-all">
      <span class="v2-label">{{localize 'SDM.PowerOvercharge'}}</span>
      <textarea name="system.power.overcharge" rows="2">{{{system.power.overcharge}}}</textarea>
    </label>
  </div>
</section>
