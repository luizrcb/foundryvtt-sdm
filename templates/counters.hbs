{{#if (sdmFeature 'counters')}}
  {{!-- Counters of an item or actor (effects use them as @item/@actor.counters.<key>.value) --}}
  <div class="sdm-counters" data-collapse-key="counters">
    <header>
      <strong><a class="sdm-collapse-toggle" data-tooltip="{{localize 'SDM.Collapse'}}"><i class="fa-solid fa-chevron-down" inert></i></a> {{localize 'SDM.Counter.Title'}} <span class="sdm-section-count">({{counters.length}})</span></strong>
      {{#if @root.editable}}
      <a data-action="addCounter"><i class="fa-solid fa-plus"></i> {{localize 'SDM.Counter.New'}}</a>
      {{/if}}
    </header>
    {{#each counters as |counter|}}
    <div class="sdm-counter-row">
      <input class="sdm-counter-label" type="text" name="system.counters.{{counter.key}}.label" value="{{counter.label}}" />
      <div class="sdm-counter-value">
        {{#if @root.editable}}<a data-action="stepCounter" data-key="{{counter.key}}" data-step="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
        <input type="number" min="0" name="system.counters.{{counter.key}}.value" value="{{counter.value}}" data-dtype="Number" />
        {{#if @root.editable}}<a data-action="stepCounter" data-key="{{counter.key}}" data-step="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </div>
      <label data-tooltip="{{localize 'SDM.Counter.MaxHint'}}">{{localize 'SDM.Counter.Max'}}
        <input type="number" min="0" name="system.counters.{{counter.key}}.max" value="{{counter.max}}" data-dtype="Number" /></label>
      <label data-tooltip="{{localize 'SDM.Counter.ResetValueHint'}}">{{localize 'SDM.Counter.ResetValue'}}
        <input type="number" min="0" name="system.counters.{{counter.key}}.reset_value" value="{{counter.reset_value}}" data-dtype="Number" /></label>
      <label class="sdm-counter-combat" data-tooltip="{{localize 'SDM.Counter.ResetOnCombatEndHint'}}">
        <input type="checkbox" name="system.counters.{{counter.key}}.reset_on_combat_end" {{checked counter.reset_on_combat_end}} />
        {{localize 'SDM.Counter.ResetOnCombatEnd'}}</label>
      <label data-tooltip="{{localize 'SDM.Counter.ResetEachHint'}}">{{localize 'SDM.Counter.ResetEach'}}
        <select name="system.counters.{{counter.key}}.reset_each">
          {{selectOptions (sdmCounterResetChoices) selected=counter.reset_each localize=true}}
        </select></label>
      <label data-tooltip="{{localize 'SDM.Counter.CooldownHint'}}">{{localize 'SDM.Counter.Cooldown'}}
        <input type="number" min="0" step="1" name="system.counters.{{counter.key}}.cooldown" value="{{counter.cooldown}}" data-dtype="Number" /></label>
      {{#if counter.cooldown}}
      <select name="system.counters.{{counter.key}}.cooldown_unit">{{selectOptions (sdmCooldownUnits) selected=counter.cooldown_unit localize=true}}</select>
      <select name="system.counters.{{counter.key}}.cooldown_from">{{selectOptions (sdmCooldownFrom) selected=counter.cooldown_from localize=true}}</select>
      {{#if counter.cooldown_left}}<span class="sdm-counter-cooldown" data-tooltip="{{localize 'SDM.Counter.CooldownLeftHint'}}"><i class="fa-solid fa-hourglass-half"></i> {{counter.cooldown_left}}</span>{{/if}}
      {{else}}
      <input type="hidden" name="system.counters.{{counter.key}}.cooldown_unit" value="{{counter.cooldown_unit}}" />
      <input type="hidden" name="system.counters.{{counter.key}}.cooldown_from" value="{{counter.cooldown_from}}" />
      {{/if}}
      <label class="sdm-counter-combat" data-tooltip="{{localize 'SDM.Counter.HeroDieHint'}}">
        <input type="checkbox" name="system.counters.{{counter.key}}.hero_die" {{checked counter.hero_die}} />
        {{localize 'SDM.Counter.HeroDie'}}</label>
      <code class="sdm-counter-ref" data-tooltip="{{localize 'SDM.Counter.ReferenceHint' ref=(concat @root.counterScope '.counters.' counter.key '.value')}}">{{@root.counterScope}}.counters.{{counter.key}}.value</code>
      {{#if @root.editable}}
      <div class="sdm-counter-actions">
        <a data-action="resetCounter" data-key="{{counter.key}}" data-tooltip="{{localize 'SDM.Counter.Reset'}}"><i class="fa-solid fa-rotate-left"></i></a>
        <a data-action="removeCounter" data-key="{{counter.key}}" data-tooltip="{{localize 'SDM.Counter.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/if}}
    </div>
    {{else}}
    <p class="hint">{{localize 'SDM.Counter.None'}}</p>
    {{/each}}
    {{#if (eq @root.counterScope '@item')}}
    <div class="sdm-counter-row sdm-uses-row">
      <label data-tooltip="{{localize 'SDM.Once.Hint'}}">{{localize 'SDM.Once.Label'}}
        <select name="system.once_ability">{{selectOptions (sdmOnceAbilityChoices) selected=@root.item.system.once_ability localize=true}}</select></label>
    </div>
    {{/if}}
    {{#if (and (eq @root.counterScope '@item') (eq @root.item.type 'gear'))}}
    <div class="sdm-counter-row sdm-uses-row">
      <label data-tooltip="{{localize 'SDM.Uses.Hint'}}">{{localize 'SDM.Uses.Label'}}
        <select name="system.uses.counter">{{selectOptions @root.usesCounterChoices selected=@root.system.uses.counter}}</select></label>
      {{#if @root.system.uses.counter}}
      <select name="system.uses.mode" data-tooltip="{{localize 'SDM.Uses.ModeHint'}}">{{selectOptions @root.usesModes selected=@root.system.uses.mode localize=true}}</select>
      {{else}}
      <input type="hidden" name="system.uses.mode" value="{{@root.system.uses.mode}}" />
      {{/if}}
    </div>
    {{/if}}
  </div>
{{/if}}
