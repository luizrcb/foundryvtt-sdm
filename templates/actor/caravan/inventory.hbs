{{! Features Tab }}
<section class='tab inventory scrollable {{tab.cssClass}}' data-group='primary' data-tab='inventory'>
  {{#if isCompactMode}}
    {{!-- COMPACT INVENTORY (single column) --}}
  <div class="grid grid-3col">
    <div class="main grid-span-3">
      <section>
        <ol class='items-list collapsible-items'>
          <li class='item flexrow items-header caravan-item-header'>
            <div class='item-name'>
              <div>
                <span class="">{{localize 'SDM.CaravanItemSlots'}}</span>
                <span>[{{totalUsedSlots}}/{{totalMaxSlots}}]</span>
              </div>
              {{#if overloaded}}
                <div class="fumble ml-5">
                  {{localize 'SDM.StatusOverloaded'}}
                  <i class="fa fa-weight-hanging fumble"></i>
                </div>
              {{/if}}
              <div class="rollable ml-10" style="align-self: flex-end;" data-action="consumeSupplies">
                <i class="fa-solid fa-sack-xmark" data-action="consumeSupplies"></i>
                <span>{{localize 'SDM.ConsumeSupply'}}</span>
              </div>
            </div>
            <div class='item-formula'>
            </div>
            <div class='item-controls'>
              {{#if @root.editable}}
              <a
                class='item-control item-create'
                data-tooltip="{{localize 'SDM.DOCUMENT.Create' type=(localize 'TYPE.Item')}}"
                data-action='createDoc'
                data-document-class='Item'
                data-type='gear'
              >
                <i class='fa-solid fa-plus'></i>
                {{localize 'SDM.DOCUMENT.New' type=(localize 'TYPE.Item')}}
              </a>
              {{/if}}
            </div>
          </li>
         </ol>
       </section>
    </div>
     {{!-- Crew Sack --}}
     {{#if (gt crewSack.maxSlots 0)}}
      <div class="main grid-span-1 list-border crew-sack" data-drop="false">
        <div class="flex-group-center header flexrow mt-5">
          <div>
            <span>{{localize 'SDM.Passengers'}}</span>
          </div>
          <div>
            <span>[{{crewSack.usedSlots}}/{{crewSack.maxSlots}}]</span>
          </div>
        </div>
        <section>
          <ol class='items-list collapsible-items list-border crew-list'>
            {{#each crewSack.members as |member|}}
              <li class="item flexrow" data-action="viewCrewMember" data-key="{{member.key}}">
                <span class="item-name">
                  {{#if (eq member.type 'character')}}
                    <i class="fa-regular fa-user" data-tooltip="TYPES.Actor.character"></i>
                  {{else}}
                    <i class="fa-solid fa-user" data-tooltip="TYPES.Actor.npc"></i>
                  {{/if}}
                  {{member.name}}
                </span>
                <span class="item-weight">{{member.weight}} {{localize 'SDM.UnitStonesAbbr'}} <i class="fa fa-weight-hanging"></i></span>
              </li>
            {{/each}}
          </ol>
        </section>
      </div>
    {{/if}}
    {{#each cargo as |sack|}}
    <div class="main grid-span-1 list-border sack-drop" data-sack-index="{{@index}}" data-drop="true">
      <div class="flex-group-center flexrow mt-5">
        <div>
           <span>{{toPascalCase (localize 'SDM.UnitSack')}} {{addOne @index}}</span>
        </div>
        <div>
          <span>[{{sack.usedSlots}}/{{sack.maxSlots}}]</span>
        </div>
        <div>
          <span>({{localize 'SDM.CashSymbol'}}{{getEstimatedValue sack}})</span>
        </div>
      </div>
      <div class="flex-group-center flexrow">
         <input class="sack-name subtitle labelInput"
             type="text"
             name="system.inventory.{{@index}}.name"
             value="{{sack.name}}"
             maxlength="35"
             data-no-drag="true" />
      </div>
      <section>
        <ol class='items-list collapsible-items list-border'>
        {{#each (@lookup sack 'items') as |item id|}}
          {{> ($$ "actor/item") item=item actorType=@root.actor.type}}
        {{/each}}
        </ol>
       </section>
    </div>
    {{/each}}

    {{#if overflow}}
      <div class="main grid-span-1 list-border sack-drop sack-overflow"
          data-sack-index="{{system.capacity}}" data-drop="true">
        <div class="flex-group-center flexrow mt-5">
          <div><span>{{toPascalCase (localize 'SDM.UnitSack')}} {{localize 'SDM.SackOverflow'}}</span></div>
          <div><span>[{{overflow.usedSlots}}]</span></div>
          <div><span>({{localize 'SDM.CashSymbol'}}{{getEstimatedValue overflow}})</span></div>
        </div>
        <section>
          <ol class='items-list collapsible-items list-border'>
            {{#each (@lookup overflow 'items') as |item id|}}
              {{> ($$ "actor/item") item=item actorType=@root.actor.type}}
            {{/each}}
          </ol>
        </section>
      </div>
    {{/if}}
  </div>
  {{else}}
  {{!-- NORMAL INVENTORY (5‑column grid) --}}
  <div class="grid grid-5col">
    <div class="main grid-span-5">
      <section>
        <ol class='items-list collapsible-items'>
          <li class='item flexrow items-header caravan-item-header'>
            <div class='item-name'>
              <div>
                <span class="">{{localize 'SDM.CaravanItemSlots'}}</span>
                <span>[{{totalUsedSlots}}/{{totalMaxSlots}}]</span>
              </div>
              {{#if system.overloaded}}
                <div class="fumble ml-5">
                  {{localize 'SDM.StatusOverloaded'}}
                  <i class="fa fa-weight-hanging fumble"></i>
                </div>
              {{/if}}
              <div class="rollable ml-10" style="align-self: flex-end;" data-action="consumeSupplies">
                <i class="fa-solid fa-sack-xmark" data-action="consumeSupplies"></i>
                <span>{{localize 'SDM.ConsumeSupply'}}</span>
              </div>
            </div>
            <div class='item-formula'>
            </div>
            <div class='item-controls'>
              {{#if @root.editable}}
              <a
                class='item-control item-create'
                data-tooltip="{{localize 'SDM.DOCUMENT.Create' type=(localize 'TYPE.Item')}}"
                data-action='createDoc'
                data-document-class='Item'
                data-type='gear'
              >
                <i class='fa-solid fa-plus'></i>
                {{localize 'SDM.DOCUMENT.New' type=(localize 'TYPE.Item')}}
              </a>
              {{/if}}
            </div>
          </li>
         </ol>
       </section>
    </div>
    {{!-- Crew Sack --}}
    {{#if (gt crewSack.maxSlots 0)}}
      <div class="main grid-span-1 list-border crew-sack" data-drop="false">
        <div class="flex-group-center header flexrow mt-5">
          <div>
            <span>{{localize 'SDM.Passengers'}}</span>
          </div>
          <div>
            <span>[{{crewSack.usedSlots}}/{{crewSack.maxSlots}}]</span>
          </div>
        </div>
        <section>
          <ol class='items-list collapsible-items list-border crew-list'>
            {{#each crewSack.members as |member|}}
              <li class="item flexrow" data-action="viewCrewMember" data-key="{{member.key}}">
                <span class="item-name">
                  {{#if (eq member.type 'character')}}
                    <i class="fa-regular fa-user" data-tooltip="TYPES.Actor.character"></i>
                  {{else}}
                    <i class="fa-solid fa-user" data-tooltip="TYPES.Actor.npc"></i>
                  {{/if}}
                  {{member.name}}
                </span>
                <span class="item-weight">{{member.weight}} {{localize 'SDM.UnitStonesAbbr'}} <i class="fa fa-weight-hanging"></i> </span>
              </li>
            {{/each}}
          </ol>
        </section>
      </div>
    {{/if}}
    {{#each cargo as |sack|}}
    <div class="main grid-span-1 list-border sack-drop" data-sack-index="{{@index}}" data-drop="true">
      <div class="flex-group-center flexrow mt-5">
        <div>
           <span>{{toPascalCase (localize 'SDM.UnitSack')}} {{addOne @index}}</span>
        </div>
        <div>
          <span>[{{sack.usedSlots}}/{{sack.maxSlots}}]</span>
        </div>
        <div>
          <span>({{localize 'SDM.CashSymbol'}}{{getEstimatedValue sack}})</span>
        </div>
      </div>
      <div class="flex-group-center flexrow">
         <input class="sack-name subtitle labelInput"
             type="text"
             name="system.inventory.{{@index}}.name"
             value="{{sack.name}}"
             maxlength="35"
             data-no-drag="true" />
      </div>
      <section>
        <ol class='items-list collapsible-items list-border'>
        {{#each (@lookup sack 'items') as |item id|}}
          {{> ($$ "actor/item") item=item actorType=@root.actor.type}}
        {{/each}}
        </ol>
       </section>
    </div>
    {{/each}}

    {{#if overflow}}
      <div class="main grid-span-1 list-border sack-drop sack-overflow"
          data-sack-index="{{system.capacity}}" data-drop="true">
        <div class="flex-group-center flexrow mt-5">
          <div><span>{{toPascalCase (localize 'SDM.UnitSack')}} {{localize 'SDM.SackOverflow'}}</span></div>
          <div><span>[{{overflow.usedSlots}}]</span></div>
          <div><span>({{localize 'SDM.CashSymbol'}}{{getEstimatedValue overflow}})</span></div>
        </div>
        <section>
          <ol class='items-list collapsible-items list-border'>
            {{#each (@lookup overflow 'items') as |item id|}}
              {{> ($$ "actor/item") item=item actorType=@root.actor.type}}
            {{/each}}
          </ol>
        </section>
      </div>
    {{/if}}
  </div>
  {{/if}}
</section>