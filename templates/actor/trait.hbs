<li
  class='item flexrow {{trait.system.status}}'
  data-item-id='{{trait._id}}'
  data-drag='true'
  data-document-class='Item'
  data-tooltip='{{getItemTitle trait}}'
>
  <div class='item-name' style="cursor:pointer;" data-action='openDoc'>
    {{#if (and
      (eq trait.system.type 'power')
      (ne trait.system.status 'broken')
      (or
        (eq trait.system.learning.required_successes 0)
        (lte trait.system.learning.required_successes trait.system.learning.sources)
      )
    )}}
      <div
        class="item-image rollable-image"
        data-action="roll"
        data-type="power"
        data-label="{{trait.name}}"
        data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.Power')}}"
      >
        <img class="normal-img" src="{{trait.img}}" width="24" height="24" />
        <i class="fa-solid fa-dice-d20 hover-d20"></i>
        {{#if (eq trait.system.status 'notched')}}
          <i class="fa fa-hammer overlay-icon notched-icon"></i>
        {{/if}}
        {{#if (eq trait.system.status 'broken')}}
          <i class="fa fa-ban overlay-icon broken-icon"></i>
        {{/if}}
      </div>
    {{else}}
      <div class="item-image">
        <img src="{{trait.img}}" width="24" height="24" />
        {{#if (eq trait.system.status 'notched')}}
          <i class="fa fa-hammer overlay-icon notched-icon"></i>
        {{/if}}
        {{#if (eq trait.system.status 'broken')}}
          <i class="fa fa-ban overlay-icon broken-icon"></i>
        {{/if}}
      </div>
    {{/if}}

    <div class='flexrow'>
      {{#if (and
        (eq trait.system.type 'pet')
        (ne trait.system.pet '')
      )}}
        <div
          class='rollable flexrow'
          data-action='openPetSheet'
          data-label='{{trait.name}}'
          data-tooltip="SDM.OpenPetSheet"
        >
          <i class='fa-solid fa-paw roll-icon'></i>
        </div>
      {{/if}}

      {{#if trait.system.is_hallmark}}<i class="fa-regular fa-star hallmark" data-tooltip="{{localize 'SDM.HallmarkItem'}}"></i>{{/if}}
      {{#if (and (gt trait.system.charges.max 0) (has trait.system.features 'charges'))}}
        <span data-tooltip="{{localize 'SDM.ItemCharges'}}">({{trait.system.charges.value}}/{{trait.system.charges.max}})&nbsp;</span>
      {{/if}}
      {{#if (sdmIsLit trait)}}
        <a class="rollable sdm-lit-icon mr-3" {{#if @root.editable}}data-action="putOutLight"{{/if}} data-tooltip="{{localize 'SDM.Light.LitHint'}}"><i class="fa-solid fa-fire-flame-curved"></i></a>
      {{else if (and @root.editable (sdmCanLight trait))}}
        <a class="rollable sdm-unlit-icon mr-3" data-action="lightItem" data-tooltip="{{localize 'SDM.Light.UnlitHint'}}"><i class="fa-solid fa-fire-flame-curved"></i></a>
      {{/if}}
      {{trait.name}}
      {{#if (and (eq trait.system.type 'skill') (gt trait.system.skill.modifier_final 0))}}
        (+{{trait.system.skill.modifier_final}})
      {{/if}}
      {{!-- Counters: click +1, right-click −1 --}}
      {{#if (sdmFeature 'counters')}}
      {{#each trait.system.counters as |counter key|}}
        <a class="sdm-counter-chip ml-3" {{#if @root.editable}}data-action="stepItemCounter"{{/if}} data-key="{{key}}"
          data-tooltip="{{localize 'SDM.Counter.RowHint' label=counter.label}}">{{counter.label}} {{counter.value}}{{#if counter.cooldown_left}} <span class="sdm-counter-cooldown" data-tooltip="{{localize 'SDM.Counter.CooldownLeftHint'}}"><i class="fa-solid fa-hourglass-half"></i> {{counter.cooldown_left}}</span>{{/if}}</a>
      {{/each}}
      {{/if}}
    </div>
  </div>
</li>