<li
  class='item flexrow {{item.system.status}} {{#if (ne item.system.container "")}}inContainer{{/if}} {{#if (or (and item.system.animation.active (eq item.system.animation.mode "walks")) item.flags.sdm.lightLeft)}}is-walked-away{{/if}}'
  data-item-id='{{item._id}}'
  data-drag='true'
  data-document-class='Item'
  data-tooltip="{{getItemTitle item}}"
>
  <div class='item-name' style="cursor:pointer;" data-action='openDoc'>
    {{#if (sdmRowImage item actorType @root.editable)}}
      {{#if (eq (sdmRowImage item actorType @root.editable) 'damage')}}
        <div
          class="item-image rollable-image"
          data-action="roll"
          data-type="damage"
          data-label="{{item.name}}"
          data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.Damage')}}"
        >
          <img class="normal-img {{ifThen item.system.readied 'readied' 'not-readied'}}" src="{{item.img}}" width="24" height="24" />
          <i class="fa-solid fa-dice-d20 hover-d20"></i>
          {{#if (eq item.system.status 'notched')}}<i class="fa fa-hammer overlay-icon notched-icon"></i>{{/if}}
          {{#if (eq item.system.status 'broken')}}<i class="fa fa-ban overlay-icon broken-icon"></i>{{/if}}
        </div>
      {{else if (eq (sdmRowImage item actorType @root.editable) 'power')}}
        <div
          class="item-image rollable-image"
          data-action="roll"
          data-type="power"
          data-label="{{item.name}}"
          data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.Power')}}"
        >
          <img class="normal-img {{ifThen item.system.readied 'readied' 'not-readied'}}" src="{{item.img}}" width="24" height="24"/>
          <i class="fa-solid fa-dice-d20 hover-d20"></i>
          {{#if (eq item.system.status 'notched')}}<i class="fa fa-hammer overlay-icon notched-icon"></i>{{/if}}
          {{#if (eq item.system.status 'broken')}}<i class="fa fa-ban overlay-icon broken-icon"></i>{{/if}}
        </div>
      {{else}}
        <div
          class="item-image rollable-image"
          data-action="roll"
          data-type="power_album"
          data-label="{{item.name}}"
          data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.PowerAlbum')}}"
        >
          <img class="normal-img {{ifThen item.system.readied 'readied' 'not-readied'}}" src="{{item.img}}" width="24" height="24" />
          <i class="fa-solid fa-dice-d20 hover-d20"></i>
          {{#if (eq item.system.status 'notched')}}<i class="fa fa-hammer overlay-icon notched-icon"></i>{{/if}}
          {{#if (eq item.system.status 'broken')}}<i class="fa fa-ban overlay-icon broken-icon"></i>{{/if}}
        </div>
      {{/if}}
    {{else}}
      <div class="item-image">
        <img class="{{ifThen item.system.readied 'readied' 'not-readied'}}" src="{{item.img}}" width="24" height="24" data-tooltip="{{item.name}}"/>
        {{#if (eq item.system.status 'notched')}}<i class="fa fa-hammer overlay-icon notched-icon"></i>{{/if}}
        {{#if (eq item.system.status 'broken')}}<i class="fa fa-ban overlay-icon broken-icon"></i>{{/if}}
      </div>
    {{/if}}


    <div class="flexrow">
      {{!-- Rolls the item's features add (the image is its subtype's roll) --}}
      {{#each (sdmRowIcons item actorType @root.editable) as |rollType|}}
        {{#if (eq rollType 'damage')}}
        <div class="rollable flexrow sdm-row-roll" data-action="roll" data-type="damage" data-label="{{../item.name}}" data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.Damage')}}">
          <i class="fa-solid fa-sword roll-icon mr-3"></i>
        </div>
        {{else}}
        <div class="rollable flexrow sdm-row-roll" data-action="roll" data-type="power_album" data-label="{{../item.name}}" data-tooltip="{{localize 'SDM.RollType' type=(localize 'SDM.PowerAlbum')}}">
          <i class="fa-solid fa-book roll-icon mr-3"></i>
        </div>
        {{/if}}
      {{/each}}
      {{!-- Use: only readied (a packed item takes an action to ready first) --}}
      {{#if (and (has item.system.features 'consumable') item.system.readied @root.editable (ne actorType 'caravan') (ne item.system.status 'broken') (ne item.system.resources 'run_out'))}}
        <a class="rollable mr-3" data-action="useItem" data-tooltip="{{sdmUseTooltip item}}"><i class="fa-solid fa-hand-holding-medical"></i></a>
      {{/if}}
      {{#if (sdmIsLit item)}}
        <a class="rollable sdm-lit-icon mr-3" {{#if @root.editable}}data-action="putOutLight"{{/if}} data-tooltip="{{localize 'SDM.Light.LitHint'}}"><i class="fa-solid fa-fire-flame-curved"></i></a>
      {{else if (and @root.editable (ne actorType 'caravan') (sdmCanLight item))}}
        <a class="rollable sdm-unlit-icon mr-3" data-action="lightItem" data-tooltip="{{localize 'SDM.Light.UnlitHint'}}"><i class="fa-solid fa-fire-flame-curved"></i></a>
      {{/if}}
      {{#if (eq item.system.resources 'running_low')}}
        <div data-tooltip="{{localize 'SDM.ItemStatusRunningLow'}}">
          <i class="fa-solid fa-battery-quarter mr-3"></i>
        </div>
      {{/if}}
      {{#if (eq item.system.resources 'run_out')}}
        <div data-tooltip="{{localize 'SDM.ItemStatusRunOut'}}">
          <i class="fa-solid fa-battery-empty mr-3"></i>
        </div>
      {{/if}}
      {{#if (sdmSingleUse item)}}
        <div data-tooltip="{{localize 'SDM.SingleUse.Label'}}">
          <i class="fa-solid fa-hourglass-end mr-3"></i>
        </div>
      {{/if}}
      {{#if (and
        (eq item.system.type 'pet')
        (ne item.system.pet '')
      )}}
        <div
          class='rollable flexrow'
          data-action='openPetSheet'
          data-label='{{item.name}}'
          data-tooltip="SDM.OpenPetSheet"
        >
          <i class='fa-solid fa-paw roll-icon'></i>
        </div>
      {{/if}}


      {{#if (and (gt item.system.slots_taken 1) (ne item.system.size.unit 'sacks'))}}
        <span class="mr-3" data-tooltip="{{item.system.slots_taken}} {{localize 'SDM.UnitStones'}}">[{{item.system.slots_taken}}]</span>
      {{/if}}
      {{#if (and (gt item.system.slots_taken 1) (eq item.system.size.unit 'sacks'))}}
        <span class="mr-3" data-tooltip="{{toSacks item.system.slots_taken false}} {{ifThen (gt (toSacks item.system.slots_taken false) 1) (localize 'SDM.UnitSacks') (localize 'SDM.UnitSack')}}">[{{toSacks item.system.slots_taken}}]</span>
      {{/if}}

      {{#if (eq item.system.size.unit 'cash')}}{{localeNumber item.system.quantity}}{{/if}}
      {{#if item.system.is_hallmark}}<i class="fa-regular fa-star hallmark" data-tooltip="{{sdmHallmarkTooltip item}}"></i>{{/if}}
      {{#if (and item.system.is_hallmark (gt item.system.hallmark.pending_upgrades 0))}}<a class="sdm-pending-upgrade ml-3" {{#if @root.editable}}data-action="chooseHallmarkUpgrade"{{/if}} data-tooltip="{{localize 'SDM.Upgrade.ChooseTooltip'}}"><i class="fa-solid fa-angles-up"></i> {{item.system.hallmark.pending_upgrades}}</a>{{/if}}

      {{!-- Counters: click +1, right-click −1 --}}
      {{#if (and (ne actorType 'caravan') (sdmFeature 'counters'))}}
      {{#each item.system.counters as |counter key|}}
        <a class="sdm-counter-chip mr-3" {{#if @root.editable}}data-action="stepItemCounter"{{/if}} data-key="{{key}}"
          data-tooltip="{{localize 'SDM.Counter.RowHint' label=counter.label}}">{{counter.label}} {{counter.value}}</a>
      {{/each}}
      {{/if}}
      {{!-- A lit item left on the map (no Item Piles): picked up from the token's HUD next to it --}}
      {{#if item.flags.sdm.lightLeft}}
        <a class="mr-3 sdm-animated-icon" data-tooltip="{{localize 'SDM.Light.LeftOnMapRow'}}"><i class="fa-solid fa-location-dot"></i></a>
      {{/if}}
      {{!-- Animated: the ghost (the Referee clicks it to deanimate); can be animated: a faded ghost to
            animate it (the Referee) or ask the Referee (the owner), as the right-click menu --}}
      {{#if item.system.animation.active}}
        <a class="mr-3 sdm-animated-icon{{#if @root.isGM}} rollable{{/if}}" {{#if @root.isGM}}data-action="deanimateItem"{{/if}} data-tooltip="{{#if (eq item.system.animation.mode 'walks')}}{{localize 'SDM.Animation.Walked'}}{{else}}{{localize 'SDM.Animation.EnergyActive'}}{{/if}}{{#if @root.isGM}}: {{localize 'SDM.Animation.ClickDeanimate'}}{{/if}}"><i class="fa-solid fa-ghost"></i></a>
      {{else if (and @root.editable (ne actorType 'caravan') (sdmCanAnimate item))}}
        <a class="rollable mr-3 sdm-unanimated-icon" data-action="{{#if @root.isGM}}animateItem{{else}}requestAnimation{{/if}}" data-tooltip="{{#if @root.isGM}}{{localize 'SDM.Animation.ClickAnimate'}}{{else}}{{localize 'SDM.Animation.ClickRequest'}}{{/if}}"><i class="fa-solid fa-ghost"></i></a>
      {{/if}}

      {{#if (and (gt item.system.charges.max 0) (has item.system.features 'charges'))}}
        <span data-tooltip="{{localize 'SDM.ItemCharges'}}" class="mr-3">({{item.system.charges.value}}/{{item.system.charges.max}})</span>
      {{/if}}

      {{#if (and item.system.starting_kit (gt item.system.packed_remaining_items 0))}}
        <span data-tooltip="{{localize 'SDM.GearStartingKitRemainingItems'}}" class="mr-3">({{item.system.packed_remaining_items}})</span>
      {{/if}}

      {{#if (and (has item.system.features 'replenish')(ne item.system.resources 'run_out'))}}
        <div class="pills flex" style="flex-basis:auto;flex-wrap:nowrap;"><span class="pill pill-s mr-3" style="flex-basis:auto;flex-wrap:nowrap;" data-tooltip="{{replace (localize 'SDM.ItemFeature.replenish') ' #' ''}}">{{replace (localize 'SDM.ItemFeature.replenishAbbr') '#' item.system.replenish.value}}</span></div>
      {{/if}}

      {{item.name}}

      {{#if (eq system.type 'container')}}
        <span class="ml-3" data-tooltip="SDM.GearContainer.Capacity">[{{item.system.container_taken}}/{{item.system.capacity.max}}]</span>
      {{/if}}

      {{#if (and (ne item.system.size.unit 'cash') (gt item.system.quantity 1))}}
        x{{localeNumber item.system.quantity}}
      {{/if}}
    </div>
  </div>

  <div class='item-controls {{ifThen (eq actorType 'caravan') 'controls-1' 'controls-2'}}'>
    {{#if @root.editable}}
      {{#if (and
        (ne actorType 'caravan')
        (ne item.system.size.unit 'cash')
        (ne item.system.status 'broken')
        (ne item.system.type 'corruption')
        (ne item.system.type 'affliction')
        (ne item.system.type 'augment')
        (ne item.system.type 'pet')
        (ne item.system.type 'container')
        (eq item.system.container '')
      )}}
        <a class="item-control">
          <i class="fa-regular fa-shield {{ifThen item.system.readied 'readied' 'not-readied'}}" data-action="toggleReadied" {{#if item.system.readied}}data-tooltip="{{localize 'SDM.ItemReadied'}}"{{else}}data-tooltip="{{localize 'SDM.ItemNotReadied'}}"{{/if}}></i>
        </a>
      {{/if}}
      {{#if (and (ne item.system.type 'corruption') (ne item.system.type 'affliction'))}}
        <a class="item-control">
          <i class="fa-regular fa-exchange" data-action="transferItem" data-tooltip="{{localize 'DOCUMENT.Transfer' type=(localize 'TYPE.Item')}}"></i>
        </a>
      {{/if}}
    {{/if}}
  </div>
</li>