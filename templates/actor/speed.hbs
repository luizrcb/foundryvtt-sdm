{{! Speed in zones per round (zones.mjs). Editing sets the base value; conditions such as slowed act on top }}
{{#if @root.speed}}<span class="sdm-speed{{#if @root.speed.slowed}} slowed{{/if}}" data-tooltip="{{@root.speed.hint}}">{{#if label}}<span class="sdm-speed-label">{{localize 'SDM.FieldSpeed'}}</span>{{else}}<i class="fa-solid fa-person-walking"></i>{{/if}}{{#if edit}}<select name="system.speed" data-dtype="Number">{{selectOptions @root.speed.choices selected=@root.speed.source localize=true}}</select>{{else}}<span class="sdm-speed-name">{{@root.speed.name}}</span>{{/if}}</span>{{/if}}
