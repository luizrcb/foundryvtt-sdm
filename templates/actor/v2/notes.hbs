{{! Sheet v2 notes tab: same editor as the classic sheet, inside a card wrapper }}
<section class="tab notes v2-notes {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <div class="v2-prose">
    {{! Editors must receive enriched text data to properly handle rolls, UUID links, etc. }}
    {{#if editable}}
    <prose-mirror
      name="system.notes"
      data-document-uuid="{{actor.uuid}}"
      value="{{system.notes}}"
      collaborate="true"
      toggled="true"
    >
      {{{enrichedNotes}}}
    </prose-mirror>
    {{else}}
    {{{enrichedNotes}}}
    {{/if}}
  </div>
</section>
