{{! Sheet v2 traits list: classic header + slot meter, classic row partials }}
<div class='v2-list'>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'></div>
      <div class='item-formula'
      >{{localize 'SDM.InventoryTraits'}} [{{@root.traitSlotsTaken}}/{{@root.system.trait_slots}}]
      </div>
      <div class='item-controls'>
        {{#if @root.editable}}
        <a
          class='item-control item-create'
          data-tooltip="{{localize 'SDM.DOCUMENT.Create' type=(localize 'TYPE.Trait')}}"
          data-action='createDoc'
          data-document-class='Item'
          data-type='trait'
        >
          <i class='fa-solid fa-plus'></i>
          {{localize 'SDM.DOCUMENT.New' type=(localize 'TYPE.Trait')}}
        </a>
        {{/if}}
      </div>
    </li>
    <li class="v2-meter-row" aria-hidden="true">
      <div class="v2-meter {{#if @root.v2.traitsMeter.over}}is-over{{/if}}" data-tooltip="{{@root.v2.traitsMeter.label}}">
        {{#each @root.v2.traitsMeter.segments}}<span class="v2-seg {{#if this.on}}is-on{{/if}}"></span>{{/each}}
      </div>
    </li>
    {{#each traits as |trait id|}}
      {{> ($$ "actor/trait") trait=trait }}
    {{/each}}
  </ol>

</div>
