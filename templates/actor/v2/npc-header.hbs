{{! NPC sheet v2 header. Keeps the same names and data-actions as actor/npc/header. Single layout (no compact/wide). }}
<header class="v2-header v2-npc">
  <div class="v2-rail">
    {{! Identity }}
    <div class="v2-identity">
      <div class="v2-portrait">
        {{#if isToken}}<div class="token-tag">{{localize 'DOCUMENT.Token'}}</div>{{/if}}
        <img src="{{actor.img}}" data-edit="img" data-action="onEditImage" data-tooltip="{{actor.name}}" />
        {{#if (isDefeated @root.statuses)}}<i class="fa fa-skull overlay-icon defeated-icon"></i>{{/if}}
      </div>
      <div class="v2-name">
        <label class="v2-label" for="v2-name-{{actor.id}}">{{localize 'SDM.FieldName'}}</label>
        <input id="v2-name-{{actor.id}}" class="v2-title" name="name" type="text" value="{{actor.name}}"
          placeholder="{{localize 'SDM.FieldName'}}" />
      </div>
      <div class="v2-chips">
        <div class="v2-chip">
          <span class="v2-label">{{localize 'SDM.FieldLevel'}}</span>
          <input type="text" name="system.level" value="{{system.level}}" data-dtype="Number" />
        </div>
        <div class="v2-chip">
          <span class="v2-label">{{localize 'SDM.FieldExperience'}}</span>
          <input type="text" name="system.experience" value="{{system.experience}}" />
        </div>
        <div class="v2-chip" data-tooltip="{{localize 'SDM.CustomInitiative'}}">
          <span class="v2-label">{{localize 'SDM.Initiative'}}</span>
          <input type="text" name="system.initiative" value="{{system.initiative}}" />
        </div>
      </div>
    </div>

    {{! Combat stats }}
    <div class="v2-npc-stats">
      <div class="v2-card v2-life">
        <span class="v2-card-title">{{localize 'SDM.FieldLifeMax'}}</span>
        <div class="v2-life-row">
          <input class="v2-big" type="text" name="system.life.value" value="{{system.life.value}}" data-dtype="Number"
            data-tooltip="{{localize 'SDM.FieldLife'}}" />
          <span class="v2-max">/</span>
          <input class="v2-max-input" type="text" name="system.life.max" value="{{system.life.max}}" data-dtype="Number"
            data-tooltip="{{localize 'SDM.FieldLifeMax'}}" />
        </div>
        <div class="v2-bar"><div class="v2-bar-fill" style="width: {{v2.lifePct}}%"></div></div>
      </div>

      <label class="v2-card v2-stat">
        <span class="v2-card-title">{{localize 'SDM.FieldDefense'}}</span>
        <span class="v2-stat-row">
          <i class="fa-solid fa-shield-halved"></i>
          <input class="v2-big" type="text" name="system.defense" value="{{system.defense}}" data-dtype="Number" />
        </span>
      </label>

      <label class="v2-card v2-stat">
        <span class="v2-card-title">{{localize 'SDM.Morale'}}</span>
        <span class="v2-stat-row">
          <i class="fa-solid fa-person-running"></i>
          <input class="v2-big" type="text" name="system.morale" value="{{system.morale}}" data-dtype="Number" />
        </span>
      </label>

      <label class="v2-card v2-stat">
        <span class="v2-card-title">{{localize 'SDM.FieldBonus'}}</span>
        <span class="v2-stat-row">
          <i class="fa-solid fa-plus-minus"></i>
          <input class="v2-big" type="text" name="system.bonus" value="{{system.bonus}}" data-dtype="Number" />
        </span>
      </label>

      <label class="v2-card v2-stat">
        <span class="v2-card-title">{{localize 'SDM.Damage'}}</span>
        <span class="v2-stat-row">
          <i class="fa-solid fa-explosion"></i>
          <input class="v2-big v2-formula" type="text" name="system.damage" value="{{system.damage}}" />
        </span>
      </label>
    </div>

    {{! Logistics }}
    <div class="v2-money v2-npc-logistics">
      <label class="v2-money-cell" data-tooltip="SDM.UnitSacks">
        <span class="v2-label">{{localize 'SDM.FieldCapacity'}}</span>
        <input type="text" name="system.capacity" value="{{system.capacity}}" data-dtype="Number" />
      </label>
      <label class="v2-money-cell">
        <span class="v2-label">{{localize 'SDM.FieldCostPerWeek'}}</span>
        <input type="text" name="system.cost" value="{{system.cost}}" />
      </label>
      <label class="v2-money-cell">
        <span class="v2-label">{{localize 'SDM.FieldSupplyPerWeek'}}</span>
        <input type="text" name="system.supply" value="{{system.supply}}" />
      </label>
    </div>
  </div>

  {{! Rolls }}
  <div class="v2-rolls v2-npc-rolls">
    <button type="button" class="v2-roll rollable" data-action="rollNPCMorale" data-label="{{localize 'SDM.Morale'}}">
      <i class="fa-solid fa-person-running rust"></i><span>{{localize 'SDM.Morale'}}</span>
    </button>
    <button type="button" class="v2-roll rollable" data-type="attack" data-action="roll" data-attack="melee"
      data-label="{{localize 'SDM.Attack'}}">
      <i class="melee-attack lime"></i><span>{{localize 'SDM.Attack'}}</span>
    </button>
    <button type="button" class="v2-roll rollable" data-action="rollNPCDamage" data-label="{{localize 'SDM.Damage'}}">
      <i class="fa-solid fa-explosion azure"></i><span>{{localize 'SDM.Damage'}}</span>
    </button>
    <button type="button" class="v2-roll is-fate rollable" data-ability="npc" data-action="rollSavingThrow"
      data-tooltip="{{localize 'SDM.SavingThrowRoll' ability=(localize 'TYPES.Actor.npc')}}">
      <i class="fa fa-shield-cat"></i><span>{{localize 'SDM.FieldSaveTarget'}}</span>
    </button>
  </div>
</header>
