{{! Sheet v2 items list: classic header + slot meter, classic row partials }}
<div class='v2-list'>
  <ol class='items-list collapsible-items'>
    <li class='item flexrow items-header'>
      <div class='item-name'></div>
      <div class='item-formula'>
      {{localize 'SDM.InventoryItems'}} [{{@root.itemSlotsTaken}}{{#if (or (
        eq @root.actor.type 'character') (eq @root.actor.type 'npc'))}}/{{@root.system.item_slots}}{{/if}}{{#if (
          gt @root.system.packed_item_slots_bonus 0)}}<i class='fa-regular fa-shield readied'></i> {{@root.packedSlotsTaken}}/{{@root.system.packed_item_slots_bonus}}<i class='fa-regular fa-shield not-readied'></i>{{/if}}]
      </div>
      <div class='item-controls'>
        {{#if @root.editable}}
        <a
          class='item-control item-create'
          data-tooltip="{{localize 'SDM.DOCUMENT.Create' type=(localize 'TYPE.Item' )}}"
          data-action='createDoc'
          data-document-class='Item'
          data-type='gear'
        >
          <i class='fa-solid fa-plus'></i>
          {{localize 'SDM.DOCUMENT.New' type=(localize 'TYPE.Item' )}}
        </a>
        {{/if}}
      </div>
    </li>
    <li class="v2-meter-row" aria-hidden="true">
      <div class="v2-meter {{#if @root.v2.itemsMeter.over}}is-over{{/if}}" data-tooltip="{{@root.v2.itemsMeter.label}}">
        {{#each @root.v2.itemsMeter.segments}}<span class="v2-seg {{#if this.on}}is-on{{/if}}"></span>{{/each}}
      </div>
    </li>
    {{#each items as |item id|}}
     {{> ($$ "actor/item") item=item actorType=@root.actor.type}}
    {{/each}}
  </ol>

</div>
