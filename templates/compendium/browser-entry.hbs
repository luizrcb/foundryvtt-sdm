<div class="item-card" data-uuid="{{uuid}}" draggable="true" {{#if tooltip}}data-tooltip="{{tooltip}}" data-tooltip-direction="UP"{{/if}}
  data-action="openLink">
  <header class="summary">
    <img class="gold-icon" src="{{img}}" alt="{{name}}">
    <div class="name-stacked">
      <div class="title flex flex-between">
        <span>{{name}}</span>
        <span class="item-cost">{{costSubtitle}}</span>
      </div>
      <div class="subtitle flex flex-between">
        <span>
          {{#if isPower}}
            {{localize 'SDM.PowerLevel'}}: {{powerLevel}}
          {{else}}
            {{typeLabel}}
          {{/if}}
          {{#if isWeapon}}
            <i class="fas fa-sword" data-tooltip="SDM.Damage"></i>
            <span data-tooltip="SDM.Damage">{{weaponDisplay}}</span>
          {{/if}}
          {{#if isArmor}}
            <i class="fas fa-shield-alt" data-tooltip="SDM.FieldArmor"></i>
            <span data-tooltip="SDM.FieldArmor">{{armorValue}}</span>
          {{/if}}
          {{#if isWard}}
            <i class="fas fa-eye" data-tooltip="TYPES.Item.ward"></i>
            <span data-tooltip="TYPES.Item.ward">{{wardValue}}</span>
          {{/if}}
          {{#if isTransport}}
            <i class="fas fa-boxes-stacked" data-tooltip="SDM.FieldCapacity"></i>
            <span data-tooltip="SDM.FieldCapacity">{{document.system.capacity}}</span>
            <i class="fas fa-gauge-high" data-tooltip="SDM.FieldSpeed"></i>
            <span data-tooltip="SDM.FieldSpeed">{{sdmSpeed document.system.speed}}</span>
            {{#if document.system.automatic}}
            <i class="fas fa-gears" data-tooltip="{{localize 'SDM.ItemVehicleAutomaticHint'}}"></i>
            {{/if}}
          {{/if}}
        </span>
        <span class="item-weight">
          {{#if isTransport}}
            {{#if document.system.supply}}
            <span data-tooltip="SDM.FieldSupplyPerWeek">{{document.system.supply}} <i class="fas fa-wheat-awn"></i></span>
            {{/if}}
          {{else if (and weightSubtitle (not isPower) (ne document.type 'trait'))}}
            {{weightSubtitle}} <i class="fa fa-weight-hanging"></i>
          {{/if}}
        </span>
      </div>
    </div>
  </header>
  <footer class="card-footer">
  {{#if features.length}}
    <ul class="pills unlist">
      {{#each features}}
        <li class="pill transparent {{className}}" data-tooltip="{{tooltip}}">
          {{label}}
        </li>
      {{/each}}
    </ul>
  {{/if}}
  <div class="flex align-center source-label mt-5">
    <span>{{source}}</span>
  </div>
  </footer>

  {{#if ../displaySelection}}
    <input type="checkbox" name="selected" value="{{uuid}}" {{#if selected}}checked{{/if}}>
  {{/if}}
</div>