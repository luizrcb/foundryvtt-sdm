<div class="custom-roll-modal">
  <h4>{{#if blindGMRoll}}<i class="fa-solid fa-eye-slash"></i>{{/if}}{{localize 'SDM.RollTitle' prefix=(ifThen blindGMRoll (concat (localize 'SDM.BlindRoll') ' ') '') title=title}}</h4>
  {{#if rollPreview}}<div class="sdm-roll-preview" aria-live="polite"></div>{{/if}}
  <form class="custom-roll-form">
    {{#if (eq type 'attack')}}
     <div class="form-group">
      <label for="attackTarget">{{localize 'SDM.AttackTarget'}}</label>
      <div class="flexrow">
        {{radioBoxes 'attackTarget' attackTargetChoices checked='physical' localize=true}}
      </div>
    </div>
    <div class="form-group mt-10">
      <label for="attackItem">{{localize 'SDM.AttackItem'}}</label>
      <div class="form-fields sdm-attack-item">
      <img class="sdm-attack-item-img" src="{{selectedAttackItemImg}}" alt="" {{#unless selectedAttackItemImg}}hidden{{/unless}} />
      <select name="attackItem" id="attackItem">
        <option value="">{{attackItemNoneLabel}}</option>
        {{selectOptions attackItemOptions valueAttr="id" labelAttr="label" selected=selectedAttackItem}}
      </select>
      </div>
    </div>
    {{/if}}
    {{#if (eq type 'power_album')}}
     <div class="form-group mt-10">
      <label for="powerIndex">{{localize 'SDM.Power'}}</label>
      <select name="powerIndex" id="powerIndex">
        {{selectOptions powerOptions valueAttr="index" labelAttr="name" selected=powerIndex}}
      </select>
    </div>
    {{/if}}
    {{#if (and (ne type 'ability') (ne type 'save') isCharacterActor)}}
    <div class="form-group mt-10">
      <label for="selectedAbility">{{localize 'SDM.Ability'}}</label>
      <select name="selectedAbility" id="selectedAbility">
        {{selectOptions abilities localize=true
          selected=(ifThen (eq type 'power_album') (lookup (lookup powerOptions @root.powerIndex) 'default_ability') ability) blank=""}}
      </select>
    </div>
    {{/if}}
    {{#if (ne type 'save')}}
    <div class="form-group mt-10">
      <label for="selectedSkill">{{localize 'SDM.Skill'}}</label>
      <select name="selectedSkill" id="selectedSkill">
        {{selectOptions availableSkills valueAttr="id" labelAttr="label" selected=selectedSkill sort=true blank=""}}
      </select>
    </div>
    {{/if}}
    <div class="form-group mt-10">
      <label for="modifier">{{localize 'SDM.RollModifier' }}</label>
      <input id="modifier" type="text" name="modifier" value="{{presetModifier}}" {{#unless (or (eq type 'damage') (eq type 'power') (eq type 'power_album') (eq type 'danger'))}}data-bonus-penalty{{/unless}} />
    </div>
    {{#if (or (eq type 'damage') (eq type 'power') (eq type 'power_album'))}}
    <div class="form-group mt-10">
      <label for="multiplier">{{localize 'SDM.RollMultiplier'}}</label>
      <select name="multiplier" id="multiplier">
        {{selectOptions multiplierOptions blank="" selected=selectedMultiplier}}
      </select>
    </div>
    {{/if}}
    {{#if (and isPowerRoll (not powerCost))}}
    <div class="mt-10 sdm-power-danger"{{#unless powerDanger}} hidden{{/unless}}>{{{powerDanger}}}</div>
    {{/if}}
    {{#if powerCost}}
    <fieldset class="mt-10 sdm-power-cost"{{#if powerCost.hidden}} hidden{{/if}}>
      <legend>
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize 'SDM.PowerCostPay.Legend'}}:
        <strong class="sdm-power-cost-value">{{powerCost.cost}}</strong> {{localize 'SDM.Boost.Life'}}
        {{#if powerCost.attack}}<span class="sdm-power-cost-note">{{localize 'SDM.PowerCostPay.AttackNote'}}</span>
        {{else if powerCost.castOnAttack}}<span class="sdm-power-cost-note">{{localize 'SDM.PowerCostPay.PaidOnAttack'}}</span>
        {{else}}<span class="sdm-power-cost-note">{{localize 'SDM.PowerCostPay.OverchargeNote'}}</span>{{/if}}
      </legend>
      <div class="sdm-power-cost-row">
        <input id="payPowerCost" type="checkbox" name="payPowerCost" checked data-tooltip="{{localize 'SDM.PowerCostPay.PayHint'}}" />
        <span class="sdm-power-cost-label">{{localize 'SDM.PowerCostPay.Pay'}}</span>
        <span class="sdm-power-cost-life">{{localize 'SDM.PowerCostPay.LifeNow' life=powerCost.life}}</span>
      </div>
      <div class="sdm-power-danger"{{#unless powerDanger}} hidden{{/unless}}>{{{powerDanger}}}</div>
      <div class="sdm-power-cost-ability" data-tooltip="{{localize 'SDM.PowerCostPay.FromAbilityHint'}}">
        <span class="sdm-power-cost-label">{{localize 'SDM.PowerCostPay.FromAbility'}}</span>
        <div class="sdm-power-cost-abilities">
          {{#each powerCost.abilities as |ab|}}
          <label class="sdm-power-cost-ab">
            <span>{{ab.abbr}}</span>
            <input type="number" name="costFrom.{{ab.key}}" value="0" min="0" max="{{ab.current}}" step="1" data-tooltip="{{localize 'SDM.PowerCostPay.AbilityNow' ability=ab.label current=ab.current}}" />
          </label>
          {{/each}}
        </div>
      </div>
    </fieldset>
    {{/if}}
    {{#if boost}}
    <div class="form-group mt-10 sdm-boost">
      <label for="useBoost">{{boostLabel}}</label>
      <input id="useBoost" type="checkbox" name="useBoost" {{#if boost.mandatory}}checked disabled data-tooltip="{{localize 'SDM.Boost.Mandatory'}}"{{/if}} />
    </div>
    {{/if}}
    {{#if (ne type 'danger')}}
    <div class="form-group mt-10">
      <label for="rollMode">{{localize 'SDM.RollMode'}}</label>
      <select name="rollMode" id="rollMode">
        {{selectOptions rollModes localize=true selected=selectedRollMode}}
      </select>
    </div>
    {{/if}}
    {{#if (and (ne type 'save') (ne type 'danger'))}}
    <div class="form-group mt-10">
      {{!-- No "for": only the checkbox toggles it (the row sits next to the Roll button) --}}
      <label>{{localize "SDM.ExplodingDice"}}</label>
      <input id="shouldExplode" type="checkbox" name="shouldExplode" aria-label="{{localize "SDM.ExplodingDice"}}"
        {{#if (and (ne type 'damage') (ne type 'power') (ne type 'power_album'))}}checked{{/if}}
      />
    </div>
    {{/if}}
  </form>
</div>
