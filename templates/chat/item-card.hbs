<div class="chat-card item-card" data-item-id="{{ item.id }}">
  {{!-- {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}} {{#if isPower}}data-power-level="{{ item.system.power.level }}"{{/if}}> --}}

  {{!-- Collapsible Item Details --}}
  <section class="card-header description collapsible {{#if collapsed}}collapsed{{/if}}">

    {{!-- Summary --}}
    <header class="summary" style="cursor:pointer;">
      <img class="gold-icon" src="{{ item.img }}" alt="{{ item.name }}">
      <div class="name-stacked border">
          <div class="title flex flex-between">
            <span>{{ item.name }}</span>
            <span class="item-cost">{{costSubtitle}} </span>
          </div>
          <div class="subtitle flex flex-center flex-between">
            <span>
              {{#if (eq item.system.type 'power')}}
                {{localize 'SDM.PowerLevel'}}: {{item.system.power.level}}
              {{else}}
                {{localize (concat 'TYPES.Item.' type)}}
              {{/if}}
              {{#if (or (eq item.system.type 'weapon') (has item.system.features 'weapon'))}}
                <i class="fas fa-sword" data-tooltip="SDM.Damage"></i> <span data-tooltip="SDM.Damage">{{item.system.weapon.damage.base}}{{#if item.system.weapon.versatile}}/{{item.system.weapon.damage.versatile}}{{/if}}{{#if item.system.weapon.range}} ({{localize (lookup config.rangeType item.system.weapon.range)}}){{/if}}</span>
              {{/if}}
              {{#if (or (eq item.system.type 'armor') (has item.system.features 'armor'))}}
                <i class="fas fa-shield-alt" data-tooltip="SDM.FieldArmor"></i><span data-tooltip="SDM.FieldArmor">{{item.system.armor.value}}</span>
              {{/if}}
              {{#if (eq item.system.type 'ward')}}
                <i class="fas fa-eye" data-tooltip="TYPES.Item.ward"></i><span data-tooltip="TYPES.Item.ward">{{item.system.ward.value}}</span>
              {{/if}}
            </span>
            <span class="item-weight">
              {{#if (ne weightSubtitle '')}}
                {{weightSubtitle}} <i class="fa fa-weight-hanging subtitle"></i>
              {{/if}}
            </span>
          </div>
      </div>
      <i class="fas fa-chevron-down fa-fw"></i>
    </header>

    {{!-- Details --}}
    <section class="details collapsible-content card-content">
      <div class="wrapper">
        {{{ item.system.description }}}
        {{#if (and (eq item.system.type 'power') (ne item.system.power.overcharge ''))}}
        <div>
          <span class="overcharge"><strong>{{localize 'SDM.PowerOvercharge'}}</strong></span>
          <div>
            {{{ item.system.power.overcharge }}}
          </div>
        </div>
        {{/if}}
      </div>
      {{#if (or
        (gt item.system.features.size 0)
        (and (eq item.system.type 'power') (eq item.system.power.is_dangerous true))
        (eq isDangerous true)
      )}}
      <div class="mt-10">
        <ul class="card-footer pills unlist">
            {{#if
              (or
              (eq isDangerous true)
              (and (eq item.system.type 'power') item.system.power.is_dangerous)
            )}}
              <li class="pill transparent rollable" data-action="rollDangerous" data-target-number="{{@root.finalPowerCost}}">
                <span data-tooltip aria-label="{{localize 'SDM.ItemFeature.dangerousDescription'}}">
                {{localize 'SDM.ItemFeature.dangerousAbbr'}}
                </span>
              </li>
            {{/if}}
            {{#each item.system.features}}
              <li class="pill transparent">
                <span data-tooltip aria-label="{{localize (concat 'SDM.ItemFeature.' this 'Description')}}">
                  {{featureDisplay this ../item.system}}
                </span>
              </li>
            {{/each}}
        </ul>
      </div>
      {{/if}}
    </section>
  </section>
</div>