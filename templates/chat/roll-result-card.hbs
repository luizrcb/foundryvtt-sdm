{{!-- Saves, usage, danger, morale, reaction, defeat, corruption, group chase, relife (renderResults.mjs renderCard) --}}
<div class="sdm-card sdm-card-result">
  {{{header}}}
  {{{rollBox}}}
  <div class="sdm-result-strip {{tone}}">
    <div class="sdm-result-who">{{#if targetNumber}}<b>{{targetLabel}} {{targetNumber}}</b>{{/if}}</div>
    <div class="sdm-result-word{{#if outcomeLong}} long{{/if}}">{{outcome}}</div>
    {{#if message}}<div class="sdm-result-message">{{message}}</div>{{/if}}
  </div>
  {{{extra}}}
  <div class="sdm-card-foot"></div>
</div>
