<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{formGroup fields.tint value=source.tint rootId=rootId}}
    {{formGroup fields.description value=source.description rootId=rootId}}
    {{formGroup fields.disabled value=source.disabled rootId=rootId}}
    {{formGroup fields.isItemMod value=source.system.isItemMod rootId=rootId}}

    {{#if source.system.isItemMod}}
    {{formGroup fields.modType value=source.system.modType options=itemModTypes sort=true localize=true rootId=rootId}}
    <div class="form-group">
      <label for="{{rootId}}-system.modCost">{{localize fields.modCost.label}}</label>
      <div class="form-fields sdm-mod-cost">
        <span class="sdm-money-sign">{{localize 'SDM.CashSymbol'}}</span>
        {{formInput fields.modCost value=source.system.modCost id=(concat rootId "-system.modCost")}}
      </div>
      {{#if fields.modCost.hint}}<p class="hint">{{localize fields.modCost.hint}}</p>{{/if}}
    </div>
    {{#if (eq source.system.modType 'ride')}}
    {{formGroup fields.modCostPerCapacity value=source.system.modCostPerCapacity rootId=rootId}}
    {{/if}}
    {{formGroup fields.isHallmarkUpgrade value=source.system.isHallmarkUpgrade rootId=rootId}}
    {{/if}}

    {{#if canAura}}
    {{formGroup fields.aura.enabled value=source.system.aura.enabled rootId=rootId}}
    {{#if source.system.aura.enabled}}
    <fieldset class="sdm-aura-fields">
      <legend>{{localize 'SDM.Aura.Title'}}</legend>
      {{formGroup fields.aura.band value=source.system.aura.band localize=true rootId=rootId}}
      {{#if (eq source.system.aura.band 'custom')}}
      {{formGroup fields.aura.spaces value=source.system.aura.spaces rootId=rootId}}
      {{#if source.system.aura.distance}}{{formGroup fields.aura.distance value=source.system.aura.distance rootId=rootId hint=(localize 'SDM.Aura.DistanceHint')}}{{/if}}
      {{/if}}
      {{formGroup fields.aura.disposition value=source.system.aura.disposition localize=true rootId=rootId}}
      {{formGroup fields.aura.applyToSelf value=source.system.aura.applyToSelf rootId=rootId}}
      {{formGroup fields.aura.evaluateOnSource value=source.system.aura.evaluateOnSource rootId=rootId}}
      {{formGroup fields.aura.canStack value=source.system.aura.canStack rootId=rootId}}
      {{#unless source.system.aura.canStack}}
      {{formGroup fields.aura.bestFormula value=source.system.aura.bestFormula rootId=rootId}}
      {{/unless}}
      {{formGroup fields.aura.walls value=source.system.aura.walls rootId=rootId}}
      {{formGroup fields.aura.combatOnly value=source.system.aura.combatOnly rootId=rootId}}
      {{formGroup fields.aura.showRadius value=source.system.aura.showRadius rootId=rootId}}
      {{formGroup fields.aura.color value=source.system.aura.color rootId=rootId}}
      {{formGroup fields.aura.lightPreset value=source.system.aura.lightPreset localize=true rootId=rootId}}
      {{#if (eq source.system.aura.lightPreset 'custom')}}
      {{formGroup fields.aura.lightBright value=source.system.aura.lightBright rootId=rootId}}
      {{formGroup fields.aura.lightDim value=source.system.aura.lightDim rootId=rootId}}
      {{/if}}
      {{#unless (eq source.system.aura.lightPreset 'none')}}
      {{formGroup fields.aura.lightAnimation value=source.system.aura.lightAnimation localize=true rootId=rootId}}
      {{/unless}}
    </fieldset>
    {{/if}}
    {{formGroup fields.roundDamage.formula value=source.system.roundDamage.formula rootId=rootId}}
    {{#if source.system.roundDamage.formula}}
    {{formGroup fields.roundDamage.target value=source.system.roundDamage.target localize=true rootId=rootId}}
    {{/if}}
    {{/if}}
    {{#if fields.turnHeal}}
    {{formGroup fields.turnHeal.formula value=source.system.turnHeal.formula rootId=rootId}}
    {{#if source.system.turnHeal.formula}}
    {{formGroup fields.turnHeal.blockedBy value=source.system.turnHeal.blockedBy options=statuses sort=true rootId=rootId classes="statuses"}}
    {{/if}}
    {{/if}}

    {{#if isActorEffect}}
    {{formGroup fields.origin value=source.origin rootId=rootId disabled=true}}
    {{else if isItemEffect}}
    {{formGroup fields.transfer value=source.transfer rootId=rootId}}
    {{/if}}

    {{formGroup fields.statuses value=source.statuses options=statuses sort=true rootId=rootId classes="statuses"}}
    {{formGroup fields.showIcon value=source.showIcon options=showIconOptions rootId=rootId}}
</section>