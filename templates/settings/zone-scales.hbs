<fieldset class="sdm-config sdm-zone-scales">
  <legend>{{localize 'SDM.Zones.Scales'}}</legend>
  <p class="hint">{{localize 'SDM.Zones.ScalesHint'}}</p>
  <table>
    <thead>
      <tr>
        <th></th>
        <th>{{localize 'SDM.Zones.UpTo' zone=(localize 'SDM.RangeClose')}}</th>
        <th>{{localize 'SDM.Zones.UpTo' zone=(localize 'SDM.RangeShort')}}</th>
        <th>{{localize 'SDM.Zones.UpTo' zone=(localize 'SDM.RangeMedium')}}</th>
        <th>{{localize 'SDM.RangeLong'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each scales as |scale|}}
      <tr>
        <th>{{scale.label}}</th>
        <td><input type="number" name="zoneScales.{{scale.key}}.close" value="{{scale.close}}" min="0" step="any" /> m</td>
        <td><input type="number" name="zoneScales.{{scale.key}}.short" value="{{scale.short}}" min="0" step="any" /> m</td>
        <td><input type="number" name="zoneScales.{{scale.key}}.medium" value="{{scale.medium}}" min="0" step="any" /> m</td>
        <td>{{localize 'SDM.Zones.Beyond'}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</fieldset>
